{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:postrank-explorer:website-navigation:1",
  "title": "Website navigation grouping, separate from catalog identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "collapseBelow",
    "sections",
    "utilities"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "collapseBelow": {
      "enum": [
        "lg",
        "xl"
      ]
    },
    "sections": {
      "const": [
        {
          "key": "uncertainty",
          "label": "Uncertainty",
          "landingPart": "1",
          "parts": [
            "1"
          ]
        },
        {
          "key": "grades",
          "label": "Grade reports",
          "landingPart": "2",
          "parts": [
            "2"
          ]
        },
        {
          "key": "rules",
          "label": "Reporting rules",
          "landingPart": "3",
          "parts": [
            "3"
          ]
        },
        {
          "key": "criteria",
          "label": "Multiple criteria",
          "landingPart": "4",
          "parts": [
            "4",
            "P"
          ]
        },
        {
          "key": "cases",
          "label": "Cases",
          "landingPart": "5",
          "parts": [
            "5"
          ]
        },
        {
          "key": "tools",
          "label": "Tools",
          "landingPart": "T",
          "parts": [
            "T"
          ]
        }
      ]
    },
    "utilities": {
      "const": [
        {
          "label": "Catalog",
          "href": "catalog.qmd"
        },
        {
          "label": "Terminology",
          "href": "pages/words.qmd"
        }
      ]
    }
  },
  "description": "Six original content categories with native application menus. All apps stay reachable once; profile apps belong to Multiple criteria. Website grouping is separate from numerical catalog identity."
}
