{
  "$schema": "../schema.json",
  "spec": "part1-l07",
  "description": "Part 1, Two units (L-07), the three Deeper boxes: correlated normal posteriors at the prediction's setting (pairDirection with corr), the theory book's two joint laws Q1 and Q2 with equal uniform margins on 0, 1, 2 (ch. 9; finiteLawPairwise for the direction probabilities, tieLawPairwise against constant units at 0, 1 and 2 for the margins), and a two-bump mixture posterior for unit A against a normal unit B (mixturePairDirection; rankSummaries for A's posterior mean). Settings of the boxes are settings.* keys here; the direction probability with corr .50 is cf.pair.p1corr50.pi in part1.json.",
  "license_scope": "author",
  "inputs": {
    "cf.pair.p1corr50.pi.in": {"fn":"pairDirection","args":[0.3,0.2,0.1,0.2,{"corr":{"$setting":"settings.corr50"}}],"note":"L-07 correlation box at the prediction's setting, corr .50"},
    "cf.pair.p1corr95.pi.in": {"fn":"pairDirection","args":[0.3,0.2,0.1,0.2,{"corr":{"$setting":"settings.corr95"}}],"note":"L-07 correlation box at the prediction's setting, corr .95 (the slider end)"},
    "cf.pair.p1corr50.diffsd.pi": {"fn":"pairDirection","args":[0.04,0.2,0,0.2,{"corr":{"$setting":"settings.corr50"}}],"note":"Phi(v / SD) where v = .2^2 + .2^2 - 2 (.5)(.2)(.2) = .04 is the variance of the difference under corr .50; Phi^-1 of it is sqrt(v) only if v is that variance"},
    "tb09.Q1.margins": {"fn":"tieLawPairwise","args":[[[[0],[1],[0],[1],[2]],[[1],[2],[0],[1],[2]],[[2],[0],[0],[1],[2]]],[{"$setting":"settings.tb09.state"},{"$setting":"settings.tb09.state"},{"$setting":"settings.tb09.state"}],{"ids":["A","B","v0","v1","v2"]}],"note":"law Q1 with three constant units at 0, 1 and 2: the equality probability of A (or B) with the unit at v is Pr(A = v), the margin"},
    "tb09.Q2.margins": {"fn":"tieLawPairwise","args":[[[[0],[2],[0],[1],[2]],[[1],[0],[0],[1],[2]],[[2],[1],[0],[1],[2]]],[{"$setting":"settings.tb09.state"},{"$setting":"settings.tb09.state"},{"$setting":"settings.tb09.state"}],{"ids":["A","B","v0","v1","v2"]}],"note":"law Q2 with the same three constant units"},
    "cf.mix.w20.law": {"fn":"rankSummaries","args":[{"states":[[{"$setting":"settings.mix.lo"}],[{"$setting":"settings.mix.hi"}]],"probs":[{"$setting":"settings.mix.w80"},{"$setting":"settings.mix.w20"}]}],"note":"A's posterior mean at upper weight .20: the bump centers weighted by the bump weights"},
    "cf.mix.w50.law": {"fn":"rankSummaries","args":[{"states":[[{"$setting":"settings.mix.lo"}],[{"$setting":"settings.mix.hi"}]],"probs":[{"$setting":"settings.mix.w50"},{"$setting":"settings.mix.w50"}]}],"note":"A's posterior mean at upper weight .50"}
  },
  "keys": {
    "cf.pair.p1corr50.z": {"type":"scalar","fn":"normalQuantile","args":[{"$input":"cf.pair.p1corr50.pi.in"}],"format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"Phi^-1(pi_AB) with corr .50: the gap .20 in SDs of the difference, .20 / .200"},
    "cf.pair.p1corr50.diffsd": {"type":"scalar","fn":"normalQuantile","args":[{"$input":"cf.pair.p1corr50.diffsd.pi"}],"format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"SD of the difference A - B with corr .50: sqrt(.2^2 + .2^2 - 2 (.5)(.2)(.2))"},
    "cf.pair.p1corr95.pi": {"type":"scalar","from":"cf.pair.p1corr95.pi.in","format":{"fn":"formatProb"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"pi_AB at the prediction's setting with corr .95"},
    "tb09.Q1.piBA": {"type":"fraction","fn":"finiteLawPairwise","args":[[[[0],[1]],[[1],[2]],[[2],[0]]],[{"$setting":"settings.tb09.state"},{"$setting":"settings.tb09.state"},{"$setting":"settings.tb09.state"}],{"ids":["A","B"]}],"field":"pi.0.1.0","format":{"fn":"formatRational"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"theory book ch. 9 law Q1: pi_BA"},
    "tb09.Q2.piBA": {"type":"fraction","fn":"finiteLawPairwise","args":[[[[0],[2]],[[1],[0]],[[2],[1]]],[{"$setting":"settings.tb09.state"},{"$setting":"settings.tb09.state"},{"$setting":"settings.tb09.state"}],{"ids":["A","B"]}],"field":"pi.0.1.0","format":{"fn":"formatRational"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"theory book ch. 9 law Q2: pi_BA"},
    "tb09.Q1.marginA.v0": {"type":"fraction","from":"tb09.Q1.margins","field":"t.0.0.2","format":{"fn":"formatRational"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"law Q1: Pr(A = 0)"},
    "tb09.Q1.marginA.v1": {"type":"fraction","from":"tb09.Q1.margins","field":"t.0.0.3","format":{"fn":"formatRational"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"law Q1: Pr(A = 1)"},
    "tb09.Q1.marginA.v2": {"type":"fraction","from":"tb09.Q1.margins","field":"t.0.0.4","format":{"fn":"formatRational"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"law Q1: Pr(A = 2)"},
    "tb09.Q1.marginB.v0": {"type":"fraction","from":"tb09.Q1.margins","field":"t.0.1.2","format":{"fn":"formatRational"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"law Q1: Pr(B = 0)"},
    "tb09.Q1.marginB.v1": {"type":"fraction","from":"tb09.Q1.margins","field":"t.0.1.3","format":{"fn":"formatRational"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"law Q1: Pr(B = 1)"},
    "tb09.Q1.marginB.v2": {"type":"fraction","from":"tb09.Q1.margins","field":"t.0.1.4","format":{"fn":"formatRational"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"law Q1: Pr(B = 2)"},
    "tb09.Q2.marginA.v0": {"type":"fraction","from":"tb09.Q2.margins","field":"t.0.0.2","format":{"fn":"formatRational"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"law Q2: Pr(A = 0)"},
    "tb09.Q2.marginA.v1": {"type":"fraction","from":"tb09.Q2.margins","field":"t.0.0.3","format":{"fn":"formatRational"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"law Q2: Pr(A = 1)"},
    "tb09.Q2.marginA.v2": {"type":"fraction","from":"tb09.Q2.margins","field":"t.0.0.4","format":{"fn":"formatRational"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"law Q2: Pr(A = 2)"},
    "tb09.Q2.marginB.v0": {"type":"fraction","from":"tb09.Q2.margins","field":"t.0.1.2","format":{"fn":"formatRational"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"law Q2: Pr(B = 0)"},
    "tb09.Q2.marginB.v1": {"type":"fraction","from":"tb09.Q2.margins","field":"t.0.1.3","format":{"fn":"formatRational"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"law Q2: Pr(B = 1)"},
    "tb09.Q2.marginB.v2": {"type":"fraction","from":"tb09.Q2.margins","field":"t.0.1.4","format":{"fn":"formatRational"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"law Q2: Pr(B = 2)"},
    "cf.mix.lower.pi": {"type":"scalar","fn":"pairDirection","args":[{"$setting":"settings.mix.lo"},{"$setting":"settings.mix.sd10"},{"$setting":"settings.mix.meanB"},{"$setting":"settings.mix.sd10"}],"format":{"fn":"formatProb"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"L-07 mixture box: Pr(A > B) within A's lower bump (center -.10, SD .10) against B (mean 0, SD .10)"},
    "cf.mix.upper.pi": {"type":"scalar","fn":"pairDirection","args":[{"$setting":"settings.mix.hi"},{"$setting":"settings.mix.sd10"},{"$setting":"settings.mix.meanB"},{"$setting":"settings.mix.sd10"}],"format":{"fn":"formatProb"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"L-07 mixture box: Pr(A > B) within A's upper bump (center 1.00); displayed as a bound"},
    "cf.mix.w20.pi": {"type":"scalar","fn":"mixturePairDirection","args":[[{"w":{"$setting":"settings.mix.w80"},"meanA":{"$setting":"settings.mix.lo"},"sdA":{"$setting":"settings.mix.sd10"},"meanB":{"$setting":"settings.mix.meanB"},"sdB":{"$setting":"settings.mix.sd10"},"corr":0},{"w":{"$setting":"settings.mix.w20"},"meanA":{"$setting":"settings.mix.hi"},"sdA":{"$setting":"settings.mix.sd10"},"meanB":{"$setting":"settings.mix.meanB"},"sdB":{"$setting":"settings.mix.sd10"},"corr":0}]],"format":{"fn":"formatProb"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"L-07 mixture box: pi_AB with weight .20 on A's upper bump (A's mean above B's, pi_AB below one half)"},
    "cf.mix.w50.pi": {"type":"scalar","fn":"mixturePairDirection","args":[[{"w":{"$setting":"settings.mix.w50"},"meanA":{"$setting":"settings.mix.lo"},"sdA":{"$setting":"settings.mix.sd10"},"meanB":{"$setting":"settings.mix.meanB"},"sdB":{"$setting":"settings.mix.sd10"},"corr":0},{"w":{"$setting":"settings.mix.w50"},"meanA":{"$setting":"settings.mix.hi"},"sdA":{"$setting":"settings.mix.sd10"},"meanB":{"$setting":"settings.mix.meanB"},"sdB":{"$setting":"settings.mix.sd10"},"corr":0}]],"format":{"fn":"formatProb"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"L-07 mixture box: pi_AB with equal bump weights (the means and pi_AB agree)"},
    "cf.mix.w20.meanA": {"type":"scalar","from":"cf.mix.w20.law","field":"means.0","format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"L-07 mixture box: A's posterior mean, .80 (-.10) + .20 (1.00)"},
    "cf.mix.w50.meanA": {"type":"scalar","from":"cf.mix.w50.law","field":"means.0","format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"L-07 mixture box: A's posterior mean with equal bump weights"}
  }
}
