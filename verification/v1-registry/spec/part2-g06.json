{
  "$schema": "../schema.json",
  "spec": "part2-g06",
  "description": "G-06 (The frontier, pages/grades/frontier.qmd): the report cloud of the six sites on score A (all 4,683 reports and the 603 with at most 3 grades), the vertices of its lower boundary H(m) and their edge slopes, the vertex a line of slope tau touches (the prediction at tau = .15, the presets at .20 and .40), mixtures at a mean disclosure m, the theory book's ch. 16 four-unit two-criterion law (weights 3/5, 2/5) and the ch. 19 three-unit law under its posterior-mean order. Keys that part2.json already holds (six.A.all.hull.*, six.A.cap3.hull.*, six.A.all.breakpoints, tb16.four.hull.*, tb19.law3.orderhull.lastslope, six.A.all.tau20.*, six.A.all.tau40.*) are not repeated.",
  "license_scope": "author",
  "inputs": {
    "g06.six.all.cloud": {"fn":"reportCloud","args":[{"$data":"six-sites","path":"arrays.one"},{"family":{"kind":"all"}}],"note":"every one of the 4,683 reports of the six sites on score A, summarized per N"},
    "g06.six.all.hull": {"fn":"lowerHull","args":[{"$input":"g06.six.all.cloud"}],"note":"the vertices of H(m) within all reports"},
    "g06.six.all.path": {"fn":"tauPath","args":[{"$data":"six-sites","path":"arrays.one"},{"family":{"kind":"all"}}],"note":"the best report along tau; its breakpoints are the edge slopes of H(m)"},
    "g06.six.all.tau20.sv": {"fn":"supportingVertex","args":[{"$input":"g06.six.all.hull"},{"$setting":"settings.tau20"}],"note":"the vertex a line of slope tau = .20 touches (the prediction)"},
    "g06.six.all.tau15.sv": {"fn":"supportingVertex","args":[{"$input":"g06.six.all.hull"},{"$setting":"settings.tau15"}],"note":"the vertex a line of slope tau = .15 touches (the prediction): .1444 < .15 < .1884"},
    "g06.six.all.tau15.opt": {"fn":"exactOptimum","args":[{"$data":"six-sites","path":"arrays.one"},{"tau":{"$setting":"settings.tau15"},"family":{"kind":"all"}}],"note":"the exact optimum within A_6 at tau = .15, for its risk"},
    "g06.six.all.tau50.sv": {"fn":"supportingVertex","args":[{"$input":"g06.six.all.hull"},{"$setting":"settings.tau50"}],"note":"the vertex at the half-slope end"},
    "g06.six.all.m10": {"fn":"matchedDisclosure","args":[{"$input":"g06.six.all.cloud"},{"$input":"g06.six.all.hull"},10],"note":"mean disclosure m = 10: no report states exactly 10 pairs"},
    "g06.six.all.m9": {"fn":"matchedDisclosure","args":[{"$input":"g06.six.all.cloud"},{"$input":"g06.six.all.hull"},9],"note":"mean disclosure m = 9: a mixture against the best report that states exactly 9 pairs"},
    "g06.six.cap3.cloud": {"fn":"reportCloud","args":[{"$data":"six-sites","path":"arrays.one"},{"family":{"kind":"atMost","G":{"$setting":"settings.cap3"}}}],"note":"the 603 reports with at most 3 grades"},
    "g06.six.cap3.hull": {"fn":"lowerHull","args":[{"$input":"g06.six.cap3.cloud"}]},
    "g06.six.cap3.tau20.sv": {"fn":"supportingVertex","args":[{"$input":"g06.six.cap3.hull"},{"$setting":"settings.tau20"}],"note":"preset cap3"},
    "g06.tb16": {"fn":"finiteLawPairwise","args":[[[[4,4],[3,2],[2,3],[1,1]],[[3,1],[4,2],[2,3],[1,4]]],[0.75,0.25],{"ids":["A","B","C","D"],"criteria":["c1","c2"]}],"note":"theory book ch. 16 (sec-matched-frontier-example): four units, two criteria, two states with probabilities 3/4 and 1/4 (the same law as tb16.four in part2.json)"},
    "g06.tb16.cloud": {"fn":"reportCloud","args":[{"$input":"g06.tb16"},{"w":{"$setting":"settings.w60"},"family":{"kind":"all"}}],"note":"all 75 reports with weights (3/5, 2/5)"},
    "g06.tb16.hull": {"fn":"lowerHull","args":[{"$input":"g06.tb16.cloud"}]},
    "g06.tb16.path": {"fn":"tauPath","args":[{"$input":"g06.tb16"},{"w":{"$setting":"settings.w60"},"family":{"kind":"all"}}]},
    "g06.tb16.m4": {"fn":"matchedDisclosure","args":[{"$input":"g06.tb16.cloud"},{"$input":"g06.tb16.hull"},4],"note":"theory book ch. 16: mean disclosure four, an equal mixture of 1/1/1/2 and 1/2/2/3"},
    "g06.tb16.tau20.opt": {"fn":"exactOptimum","args":[{"$input":"g06.tb16"},{"tau":{"$setting":"settings.tau20"},"w":{"$setting":"settings.w60"},"family":{"kind":"all"}}],"note":"preset tb16 (tau .20)"},
    "g06.tb16.probs": {"fn":"rankSummaries","args":[{"states":[[0.75,0.25]],"probs":null}],"note":"the two state probabilities gathered as a one-state law (means = the values)"},
    "g06.tb19": {"fn":"finiteLawPairwise","args":[[[[20],[4],[3]],[[0],[4],[3]]],[0.3,0.7],{"ids":["A","B","C"]}],"note":"theory book ch. 19 three-unit law (the law of L-09; the same input as tb19.law3.e in part2.json)"},
    "g06.tb19.orderhull": {"fn":"orderHull","args":[{"$input":"g06.tb19"},{"order":[0,1,2]}],"note":"the boundary of the reports that keep the posterior-mean order A, B, C (theory book ch. 19 H_mean)"},
    "g06.tb19.tau50.sv": {"fn":"supportingVertex","args":[{"$input":"g06.tb19.orderhull"},{"$setting":"settings.tau50"}],"note":"the vertex of the order boundary that a line of slope 1/2 touches"}
  },
  "keys": {
    "g06.six.all.v0.N": {"type":"scalar","from":"g06.six.all.hull","field":"0.N","format":{"fn":"formatCount"},"tolerance":0,"note":"N of vertex 0 of H(m) within all reports: the origin, the all-withheld report"},
    "g06.six.all.v0.E": {"type":"scalar","from":"g06.six.all.hull","field":"0.Ew","format":{"fn":"formatExpectedCount"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"E of vertex 0"},
    "g06.six.all.v0.grade": {"type":"vector","from":"g06.six.all.hull","field":"0.grade","format":{"fn":"formatGrades"},"tolerance":0,"note":"the report at vertex 0"},
    "g06.six.all.v1.N": {"type":"scalar","from":"g06.six.all.hull","field":"1.N","format":{"fn":"formatCount"},"tolerance":0,"note":"N of vertex 1 of H(m) within all reports"},
    "g06.six.all.v1.E": {"type":"scalar","from":"g06.six.all.hull","field":"1.Ew","format":{"fn":"formatExpectedCount"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"E of vertex 1"},
    "g06.six.all.v1.grade": {"type":"vector","from":"g06.six.all.hull","field":"1.grade","format":{"fn":"formatGrades"},"tolerance":0,"note":"the report at vertex 1"},
    "g06.six.all.v2.N": {"type":"scalar","from":"g06.six.all.hull","field":"2.N","format":{"fn":"formatCount"},"tolerance":0,"note":"N of vertex 2 of H(m) within all reports"},
    "g06.six.all.v2.E": {"type":"scalar","from":"g06.six.all.hull","field":"2.Ew","format":{"fn":"formatExpectedCount"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"E of vertex 2"},
    "g06.six.all.v2.grade": {"type":"vector","from":"g06.six.all.hull","field":"2.grade","format":{"fn":"formatGrades"},"tolerance":0,"note":"the report at vertex 2"},
    "g06.six.all.v3.N": {"type":"scalar","from":"g06.six.all.hull","field":"3.N","format":{"fn":"formatCount"},"tolerance":0,"note":"N of vertex 3 of H(m) within all reports"},
    "g06.six.all.v3.E": {"type":"scalar","from":"g06.six.all.hull","field":"3.Ew","format":{"fn":"formatExpectedCount"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"E of vertex 3"},
    "g06.six.all.v3.grade": {"type":"vector","from":"g06.six.all.hull","field":"3.grade","format":{"fn":"formatGrades"},"tolerance":0,"note":"the report at vertex 3"},
    "g06.six.all.v4.N": {"type":"scalar","from":"g06.six.all.hull","field":"4.N","format":{"fn":"formatCount"},"tolerance":0,"note":"N of vertex 4 of H(m) within all reports"},
    "g06.six.all.v4.E": {"type":"scalar","from":"g06.six.all.hull","field":"4.Ew","format":{"fn":"formatExpectedCount"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"E of vertex 4","same_as":"six.A.all.tau20.E"},
    "g06.six.all.v4.grade": {"type":"vector","from":"g06.six.all.hull","field":"4.grade","format":{"fn":"formatGrades"},"tolerance":0,"note":"the report at vertex 4","same_as":"six.A.all.tau20.grades"},
    "g06.six.all.v5.N": {"type":"scalar","from":"g06.six.all.hull","field":"5.N","format":{"fn":"formatCount"},"tolerance":0,"note":"N of vertex 5 of H(m) within all reports: the strict order"},
    "g06.six.all.v5.E": {"type":"scalar","from":"g06.six.all.hull","field":"5.Ew","format":{"fn":"formatExpectedCount"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"E of vertex 5","same_as":"six.A.all.tau40.E"},
    "g06.six.all.v5.grade": {"type":"vector","from":"g06.six.all.hull","field":"5.grade","format":{"fn":"formatGrades"},"tolerance":0,"note":"the report at vertex 5","same_as":"six.A.all.tau40.grades"},
    "g06.six.all.slope1": {"type":"scalar","from":"g06.six.all.path","field":"intervals.0.tauTo","format":{"fn":"formatRisk"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"slope of edge 1 of H(m) (the tau where the best report changes; equal to six.A.all.breakpoints)"},
    "g06.six.all.slope2": {"type":"scalar","from":"g06.six.all.path","field":"intervals.1.tauTo","format":{"fn":"formatRisk"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"slope of edge 2 of H(m) (the tau where the best report changes; equal to six.A.all.breakpoints)"},
    "g06.six.all.slope3": {"type":"scalar","from":"g06.six.all.path","field":"intervals.2.tauTo","format":{"fn":"formatRisk"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"slope of edge 3 of H(m) (the tau where the best report changes; equal to six.A.all.breakpoints)"},
    "g06.six.all.slope4": {"type":"scalar","from":"g06.six.all.path","field":"intervals.3.tauTo","format":{"fn":"formatRisk"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"slope of edge 4 of H(m) (the tau where the best report changes; equal to six.A.all.breakpoints)"},
    "g06.six.all.slope5": {"type":"scalar","from":"g06.six.all.path","field":"intervals.4.tauTo","format":{"fn":"formatRisk"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"slope of edge 5 of H(m) (the tau where the best report changes; equal to six.A.all.breakpoints)"},
    "g06.six.all.tau20.vertex.N": {"type":"scalar","from":"g06.six.all.tau20.sv","field":"vertex.N","format":{"fn":"formatCount"},"tolerance":0,"note":"the vertex of the What-to-try setting tau = .20","same_as":"g06.six.all.v4.N"},
    "g06.six.all.tau20.vertex.E": {"type":"scalar","from":"g06.six.all.tau20.sv","field":"vertex.Ew","format":{"fn":"formatExpectedCount"},"tolerance":{"abs":1e-12,"rel":1e-12},"same_as":"g06.six.all.v4.E"},
    "g06.six.all.tau15.vertex.N": {"type":"scalar","from":"g06.six.all.tau15.sv","field":"vertex.N","format":{"fn":"formatCount"},"tolerance":0,"same_as":"g06.six.all.v3.N","note":"the answer to the prediction"},
    "g06.six.all.tau15.vertex.E": {"type":"scalar","from":"g06.six.all.tau15.sv","field":"vertex.Ew","format":{"fn":"formatExpectedCount"},"tolerance":{"abs":1e-12,"rel":1e-12},"same_as":"g06.six.all.v3.E"},
    "g06.six.all.tau15.vertex.grade": {"type":"vector","from":"g06.six.all.tau15.sv","field":"vertex.grade","format":{"fn":"formatGrades"},"tolerance":0,"same_as":"g06.six.all.v3.grade"},
    "g06.six.all.tau15.grades": {"type":"vector","from":"g06.six.all.tau15.opt","field":"grade","format":{"fn":"formatGrades"},"tolerance":0,"same_as":"g06.six.all.v3.grade","note":"the exact optimum within A_6 at tau = .15 is the touched vertex's report"},
    "g06.six.all.tau15.risk": {"type":"scalar","from":"g06.six.all.tau15.opt","field":"risk","format":{"fn":"formatRisk"},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "g06.six.all.tau50.vertex.N": {"type":"scalar","from":"g06.six.all.tau50.sv","field":"vertex.N","format":{"fn":"formatCount"},"tolerance":0,"note":"the half-slope end: the strict order states all 15 pairs"},
    "g06.six.all.tau50.vertex.grade": {"type":"vector","from":"g06.six.all.tau50.sv","field":"vertex.grade","format":{"fn":"formatGrades"},"tolerance":0,"same_as":"g06.six.all.v5.grade"},
    "g06.six.all.m10.H": {"type":"scalar","from":"g06.six.all.m10","field":"H","format":{"fn":"formatExpectedCount"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"H(10)"},
    "g06.six.all.m10.psi": {"type":"scalar","from":"g06.six.all.m10","field":"psi","format":{"fn":"formatProb","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"the chance of the more-disclosing report in the mixture"},
    "g06.six.all.m10.lower.N": {"type":"scalar","from":"g06.six.all.m10","field":"lower.N","format":{"fn":"formatCount"},"tolerance":0},
    "g06.six.all.m10.upper.N": {"type":"scalar","from":"g06.six.all.m10","field":"upper.N","format":{"fn":"formatCount"},"tolerance":0},
    "g06.six.all.m10.lower.grade": {"type":"vector","from":"g06.six.all.m10","field":"lower.grade","format":{"fn":"formatGrades"},"tolerance":0},
    "g06.six.all.m10.upper.grade": {"type":"vector","from":"g06.six.all.m10","field":"upper.grade","format":{"fn":"formatGrades"},"tolerance":0},
    "g06.six.all.m9.H": {"type":"scalar","from":"g06.six.all.m9","field":"H","format":{"fn":"formatExpectedCount"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"H(9)"},
    "g06.six.all.m9.psi": {"type":"scalar","from":"g06.six.all.m9","field":"psi","format":{"fn":"formatProb","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "g06.six.all.m9.best.E": {"type":"scalar","from":"g06.six.all.m9","field":"best.Ew","format":{"fn":"formatExpectedCount"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"the best single report that states exactly 9 pairs"},
    "g06.six.all.m9.best.grade": {"type":"vector","from":"g06.six.all.m9","field":"best.grade","format":{"fn":"formatGrades"},"tolerance":0},
    "g06.six.all.m9.gap": {"type":"scalar","from":"g06.six.all.m9","field":"gap","format":{"fn":"formatExpectedCount"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"how far that report lies above H(9)"},
    "g06.six.cap3.tau20.vertex.N": {"type":"scalar","from":"g06.six.cap3.tau20.sv","field":"vertex.N","format":{"fn":"formatCount"},"tolerance":0,"note":"preset cap3: the last vertex of the capped boundary"},
    "g06.six.cap3.tau20.vertex.E": {"type":"scalar","from":"g06.six.cap3.tau20.sv","field":"vertex.Ew","format":{"fn":"formatExpectedCount"},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "g06.tb16.v0.N": {"type":"scalar","from":"g06.tb16.hull","field":"0.N","format":{"fn":"formatCount"},"tolerance":0,"note":"N of vertex 0 (theory book ch. 16: (0,0), (3,3/10), (5,13/20), (6,21/20))"},
    "g06.tb16.v0.E": {"type":"fraction","from":"g06.tb16.hull","field":"0.Ew","format":{"fn":"formatRational"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"weighted E of vertex 0"},
    "g06.tb16.v0.grade": {"type":"vector","from":"g06.tb16.hull","field":"0.grade","format":{"fn":"formatGrades"},"tolerance":0},
    "g06.tb16.v1.N": {"type":"scalar","from":"g06.tb16.hull","field":"1.N","format":{"fn":"formatCount"},"tolerance":0,"note":"N of vertex 1 (theory book ch. 16: (0,0), (3,3/10), (5,13/20), (6,21/20))"},
    "g06.tb16.v1.E": {"type":"fraction","from":"g06.tb16.hull","field":"1.Ew","format":{"fn":"formatRational"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"weighted E of vertex 1"},
    "g06.tb16.v1.grade": {"type":"vector","from":"g06.tb16.hull","field":"1.grade","format":{"fn":"formatGrades"},"tolerance":0},
    "g06.tb16.v2.N": {"type":"scalar","from":"g06.tb16.hull","field":"2.N","format":{"fn":"formatCount"},"tolerance":0,"note":"N of vertex 2 (theory book ch. 16: (0,0), (3,3/10), (5,13/20), (6,21/20))"},
    "g06.tb16.v2.E": {"type":"fraction","from":"g06.tb16.hull","field":"2.Ew","format":{"fn":"formatRational"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"weighted E of vertex 2"},
    "g06.tb16.v2.grade": {"type":"vector","from":"g06.tb16.hull","field":"2.grade","format":{"fn":"formatGrades"},"tolerance":0},
    "g06.tb16.v3.N": {"type":"scalar","from":"g06.tb16.hull","field":"3.N","format":{"fn":"formatCount"},"tolerance":0,"note":"N of vertex 3 (theory book ch. 16: (0,0), (3,3/10), (5,13/20), (6,21/20))"},
    "g06.tb16.v3.E": {"type":"fraction","from":"g06.tb16.hull","field":"3.Ew","format":{"fn":"formatRational"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"weighted E of vertex 3"},
    "g06.tb16.v3.grade": {"type":"vector","from":"g06.tb16.hull","field":"3.grade","format":{"fn":"formatGrades"},"tolerance":0},
    "g06.tb16.slope1": {"type":"fraction","from":"g06.tb16.path","field":"intervals.0.tauTo","format":{"fn":"formatRational"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"theory book ch. 16: slopes 1/10, 7/40, 2/5"},
    "g06.tb16.slope2": {"type":"fraction","from":"g06.tb16.path","field":"intervals.1.tauTo","format":{"fn":"formatRational"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"theory book ch. 16: slopes 1/10, 7/40, 2/5"},
    "g06.tb16.slope3": {"type":"fraction","from":"g06.tb16.path","field":"intervals.2.tauTo","format":{"fn":"formatRational"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"theory book ch. 16: slopes 1/10, 7/40, 2/5"},
    "g06.tb16.m4.H": {"type":"fraction","from":"g06.tb16.m4","field":"H","format":{"fn":"formatRational"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"theory book ch. 16: mean wrong-count 19/40"},
    "g06.tb16.m4.psi": {"type":"fraction","from":"g06.tb16.m4","field":"psi","format":{"fn":"formatRational"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"an equal mixture"},
    "g06.tb16.m4.best.E": {"type":"fraction","from":"g06.tb16.m4","field":"best.Ew","format":{"fn":"formatRational"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"theory book ch. 16: the best deterministic report with exactly four disclosures has wrong-count 7/10"},
    "g06.tb16.m4.best.grade": {"type":"vector","from":"g06.tb16.m4","field":"best.grade","format":{"fn":"formatGrades"},"tolerance":0},
    "g06.tb16.m4.gap": {"type":"fraction","from":"g06.tb16.m4","field":"gap","format":{"fn":"formatRational"},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "g06.tb16.tau20.grade": {"type":"vector","from":"g06.tb16.tau20.opt","field":"grade","format":{"fn":"formatGrades"},"tolerance":0},
    "g06.tb16.tau20.N": {"type":"scalar","from":"g06.tb16.tau20.opt","field":"N","format":{"fn":"formatCount"},"tolerance":0},
    "g06.tb16.tau20.E": {"type":"fraction","from":"g06.tb16.tau20.opt","field":"Ew","format":{"fn":"formatRational"},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "g06.tb16.tau20.risk": {"type":"fraction","from":"g06.tb16.tau20.opt","field":"risk","format":{"fn":"formatRational"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"tau + (E - tau N)/M = 1/5 + (13/20 - 1)/6"},
    "g06.tb16.prob.high": {"type":"fraction","from":"g06.tb16.probs","field":"means.0","format":{"fn":"formatRational"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"probability of the first state"},
    "g06.tb16.prob.low": {"type":"fraction","from":"g06.tb16.probs","field":"means.1","format":{"fn":"formatRational"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"probability of the second state"},
    "g06.tb19.orderhull.v0.N": {"type":"scalar","from":"g06.tb19.orderhull","field":"0.N","format":{"fn":"formatCount"},"tolerance":0,"note":"theory book ch. 19 H_mean: (0,0), (2,7/10), (3,7/5)"},
    "g06.tb19.orderhull.v0.E": {"type":"fraction","from":"g06.tb19.orderhull","field":"0.Ew","format":{"fn":"formatRational"},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "g06.tb19.orderhull.v1.N": {"type":"scalar","from":"g06.tb19.orderhull","field":"1.N","format":{"fn":"formatCount"},"tolerance":0,"note":"theory book ch. 19 H_mean: (0,0), (2,7/10), (3,7/5)"},
    "g06.tb19.orderhull.v1.E": {"type":"fraction","from":"g06.tb19.orderhull","field":"1.Ew","format":{"fn":"formatRational"},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "g06.tb19.orderhull.v2.N": {"type":"scalar","from":"g06.tb19.orderhull","field":"2.N","format":{"fn":"formatCount"},"tolerance":0,"note":"theory book ch. 19 H_mean: (0,0), (2,7/10), (3,7/5)"},
    "g06.tb19.orderhull.v2.E": {"type":"fraction","from":"g06.tb19.orderhull","field":"2.Ew","format":{"fn":"formatRational"},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "g06.tb19.tau50.vertex.grade": {"type":"vector","from":"g06.tb19.tau50.sv","field":"vertex.grade","format":{"fn":"formatGrades"},"tolerance":0,"note":"a line of slope 1/2 touches (2, 7/10), not the full order"}
  }
}
