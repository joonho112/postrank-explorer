    "l10.league.post": {"fn":"normalPosterior","args":[{"$data":"league-30","path":"tables.units.estimate"},{"$data":"league-30","path":"tables.units.se"},{"priorSd":{"$setting":"settings.prior15"}}],"note":"the frozen draw, teaching posterior with prior mean 0 and prior SD .15"},
