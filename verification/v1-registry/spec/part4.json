    "six.AB.w100.cap3.tau20.qB10.maxeB": {"type":"scalar","fn":"statedAbove","args":[{"$input":"six.AB.w100.cap3.tau20.qB10","path":"optimum.grade"},{"$data":"six-sites","path":"arrays.two"},{"tau":{"$setting":"settings.tau20"},"w":{"$setting":"settings.w0"}}],"field":"max","format":{"fn":"formatProb"},"tolerance":{"abs":1e-12,"rel":1e-12},"settings":{"w":"settings.w100","w_score_B_error":"settings.w0","tau":"settings.tau20","cap":"settings.cap3","q":"settings.qB10"},"note":"the largest stated score-B error of that report (E above F)"},
