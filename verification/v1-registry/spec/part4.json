    "six.AB.cap3.tau20.wpath": {"type":"vector","fn":"weightBreakpoints","args":[{"$data":"six-sites","path":"arrays.two"},{"tau":{"$setting":"settings.tau20"},"family":{"kind":"atMost","G":{"$setting":"settings.cap3"}}}],"field":"breakpoints","format":{"fn":"formatTuple","item":{"fn":"formatProb"}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"first-criterion weights where the optimum within at most 3 grades changes (exact breakpoints)"},
    "six.B.cap3.tau20.grades": {"type":"set","from":"six.B.cap3.tau20","field":"grades","format":{"fn":"formatTuple","item":{"fn":"formatGrades"}},"tolerance":0,"note":"score B's own best reports (two exact optima)"},
    "six.B.cap3.tau20.risk": {"type":"scalar","from":"six.B.cap3.tau20","field":"risk","format":{"fn":"formatRisk"},"tolerance":{"abs":1e-12,"rel":1e-12}},
