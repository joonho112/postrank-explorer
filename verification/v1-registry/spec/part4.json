{
  "$schema": "../schema.json",
  "spec": "part4",
  "description": "Part 4 (pages/postrank): the six sites with scores A and B (common grades, costs, budgets, tau and weight paths), the m2 known state, the ch. 13 two-unit law, family counts, Monte Carlo error (seeded draws, envelope radii), the m4 tie law and the ch. 16 three-case example.",
  "license_scope": "author",
  "inputs": {
    "six.AB.errors": {"fn":"errorArray","args":[[[{"$data":"six-sites","path":"tables.units.mean_A.0"},{"$data":"six-sites","path":"tables.units.mean_B.0"}],[{"$data":"six-sites","path":"tables.units.mean_A.1"},{"$data":"six-sites","path":"tables.units.mean_B.1"}],[{"$data":"six-sites","path":"tables.units.mean_A.2"},{"$data":"six-sites","path":"tables.units.mean_B.2"}],[{"$data":"six-sites","path":"tables.units.mean_A.3"},{"$data":"six-sites","path":"tables.units.mean_B.3"}],[{"$data":"six-sites","path":"tables.units.mean_A.4"},{"$data":"six-sites","path":"tables.units.mean_B.4"}],[{"$data":"six-sites","path":"tables.units.mean_A.5"},{"$data":"six-sites","path":"tables.units.mean_B.5"}]],[[{"$data":"six-sites","path":"tables.units.sd_A.0"},{"$data":"six-sites","path":"tables.units.sd_B.0"}],[{"$data":"six-sites","path":"tables.units.sd_A.1"},{"$data":"six-sites","path":"tables.units.sd_B.1"}],[{"$data":"six-sites","path":"tables.units.sd_A.2"},{"$data":"six-sites","path":"tables.units.sd_B.2"}],[{"$data":"six-sites","path":"tables.units.sd_A.3"},{"$data":"six-sites","path":"tables.units.sd_B.3"}],[{"$data":"six-sites","path":"tables.units.sd_A.4"},{"$data":"six-sites","path":"tables.units.sd_B.4"}],[{"$data":"six-sites","path":"tables.units.sd_A.5"},{"$data":"six-sites","path":"tables.units.sd_B.5"}]],{"ids":{"$data":"six-sites","path":"tables.units.id"},"criteria":["score_A","score_B"]}],"note":"e_ij,k for scores A and B recomputed from the normal law"},
    "six.AB.w50.cap3.tau20": {"fn":"exactOptimum","args":[{"$data":"six-sites","path":"arrays.two"},{"tau":{"$setting":"settings.tau20"},"w":{"$setting":"settings.w.equal2"},"family":{"kind":"atMost","G":{"$setting":"settings.cap3"}}}]},
    "six.AB.w50.ebar": {"fn":"weightedError","args":[{"$data":"six-sites","path":"arrays.two"},{"$setting":"settings.w.equal2"}]},
    "six.AB.w50.all.tau20": {"fn":"exactOptimum","args":[{"$data":"six-sites","path":"arrays.two"},{"tau":{"$setting":"settings.tau20"},"w":{"$setting":"settings.w.equal2"},"family":{"kind":"all"}}]},
    "six.AB.w80.cap3.tau20": {"fn":"exactOptimum","args":[{"$data":"six-sites","path":"arrays.two"},{"tau":{"$setting":"settings.tau20"},"w":{"$setting":"settings.w80"},"family":{"kind":"atMost","G":{"$setting":"settings.cap3"}}}]},
    "six.B.cap3.tau20": {"fn":"exactOptimum","args":[{"$data":"six-sites","path":"arrays.two"},{"tau":{"$setting":"settings.tau20"},"w":{"$setting":"settings.w0"},"family":{"kind":"atMost","G":{"$setting":"settings.cap3"}}}]},
    "six.AB.w50.cap3.tau20.costv": {"fn":"commonalityCost","args":[{"$data":"six-sites","path":"arrays.two"},{"w":{"$setting":"settings.w.equal2"},"tau":{"$setting":"settings.tau20"},"family":{"kind":"atMost","G":{"$setting":"settings.cap3"}}}]},
    "m2.state.tau30": {"fn":"estimandCosts","args":[[[1,-2],[0,0]],{"w":{"$setting":"settings.w75"},"a":{"$setting":"settings.w.equal2"},"tau":{"$setting":"settings.tau30"}}],"note":"vignette m2: A = (1, -2), B = (0, 0); a = (1/2, 1/2)"},
    "six.AB.w50.cap3.tau20.qB03": {"fn":"budgetFamily","args":[{"$data":"six-sites","path":"arrays.two"},{"w":{"$setting":"settings.w.equal2"},"tau":{"$setting":"settings.tau20"},"family":{"kind":"atMost","G":{"$setting":"settings.cap3"}},"q":[null,{"$setting":"settings.qB03"}]}]},
    "six.AB.w50.cap3.tau20.qB02": {"fn":"budgetFamily","args":[{"$data":"six-sites","path":"arrays.two"},{"w":{"$setting":"settings.w.equal2"},"tau":{"$setting":"settings.tau20"},"family":{"kind":"atMost","G":{"$setting":"settings.cap3"}},"q":[null,{"$setting":"settings.qB02"}]}]},
    "six.AB.w50.eq3.tau20.qB02": {"fn":"budgetFamily","args":[{"$data":"six-sites","path":"arrays.two"},{"w":{"$setting":"settings.w.equal2"},"tau":{"$setting":"settings.tau20"},"family":{"kind":"exactly","G":{"$setting":"settings.exactG3"}},"q":[null,{"$setting":"settings.qB02"}]}]},
    "six.AB.w100.cap3.tau20.qB10": {"fn":"budgetFamily","args":[{"$data":"six-sites","path":"arrays.two"},{"w":{"$setting":"settings.w100"},"tau":{"$setting":"settings.tau20"},"family":{"kind":"atMost","G":{"$setting":"settings.cap3"}},"q":[null,{"$setting":"settings.qB10"}]}]},
    "cf.mixture.conflict": {"fn":"estimandCosts","args":[[[1,0],[0,1]],{"w":{"$setting":"settings.w.equal2"},"a":{"$setting":"settings.w.equal2"},"tau":{"$setting":"settings.tau30"}}],"note":"a pair on which two equally weighted criteria certainly disagree"},
    "six.AB.w50.all.tau40": {"fn":"exactOptimum","args":[{"$data":"six-sites","path":"arrays.two"},{"tau":{"$setting":"settings.tau40"},"w":{"$setting":"settings.w.equal2"},"family":{"kind":"all"}}]},
    "six.AB.w50.all.tau35": {"fn":"exactOptimum","args":[{"$data":"six-sites","path":"arrays.two"},{"tau":{"$setting":"settings.tau35"},"w":{"$setting":"settings.w.equal2"},"family":{"kind":"all"}}]},
    "tb13.two": {"fn":"finiteLawPairwise","args":[[[[1,1],[0,0]],[[1,-1],[0,0]]],[0.5,0.5],{"ids":["A","B"],"criteria":["c1","c2"]}],"note":"theory book ch. 13 two-unit law"},
    "tb13.two.omega90": {"fn":"minimaxChoice","args":[{"$input":"tb13.two"},{"w":{"$setting":"settings.w90"},"tau":{"$setting":"settings.tau25"},"family":{"kind":"all"}}]},
    "six.A.draws.S1000": {"fn":"gaussianDraws","args":[{"$data":"six-sites","path":"tables.units.mean_A"},{"$data":"six-sites","path":"tables.units.sd_A"},{"$setting":"settings.S1000"},{"$setting":"settings.seed.s1"}]},
    "m4.weak": {"fn":"finiteLawPairwise","args":[[[[{"$data":"m4-tie-law","path":"tables.states.A.0"}],[{"$data":"m4-tie-law","path":"tables.states.B.0"}]],[[{"$data":"m4-tie-law","path":"tables.states.A.1"}],[{"$data":"m4-tie-law","path":"tables.states.B.1"}]],[[{"$data":"m4-tie-law","path":"tables.states.A.2"}],[{"$data":"m4-tie-law","path":"tables.states.B.2"}]]],{"$data":"m4-tie-law","path":"tables.states.probability"},{"ids":["A","B"],"criteria":["score"]}]},
    "m4.tie": {"fn":"tieLawPairwise","args":[[[[{"$data":"m4-tie-law","path":"tables.states.A.0"}],[{"$data":"m4-tie-law","path":"tables.states.B.0"}]],[[{"$data":"m4-tie-law","path":"tables.states.A.1"}],[{"$data":"m4-tie-law","path":"tables.states.B.1"}]],[[{"$data":"m4-tie-law","path":"tables.states.A.2"}],[{"$data":"m4-tie-law","path":"tables.states.B.2"}]]],{"$data":"m4-tie-law","path":"tables.states.probability"},{"ids":["A","B"],"criteria":["score"]}]},
    "m4.weak.AB": {"fn":"evaluateReport","args":[[1,2],{"$input":"m4.weak"},{"tau":{"$setting":"settings.tau25"}}]},
    "m4.neutral.AB": {"fn":"equalityNeutralRisk","args":[[1,2],{"$input":"m4.tie"},{"tau":{"$setting":"settings.tau25"}}]},
    "m4.weak.wh": {"fn":"evaluateReport","args":[[1,1],{"$input":"m4.weak"},{"tau":{"$setting":"settings.tau25"}}]},
    "m4.neutral.wh": {"fn":"equalityNeutralRisk","args":[[1,1],{"$input":"m4.tie"},{"tau":{"$setting":"settings.tau25"}}]},
    "m4.weak.BA": {"fn":"evaluateReport","args":[[2,1],{"$input":"m4.weak"},{"tau":{"$setting":"settings.tau25"}}]},
    "m4.neutral.BA": {"fn":"equalityNeutralRisk","args":[[2,1],{"$input":"m4.tie"},{"tau":{"$setting":"settings.tau25"}}]},
    "tb16.threecase": {"fn":"disclosedErrorEstimands","args":[[{"A":2,"N":2},{"A":0,"N":3},{"A":0,"N":0}],{"M":3}],"note":"theory book ch. 16: (wrong, stated) = (2, 2), (0, 3), (0, 0), equally likely; M = 3"},
    "six.AB.w50.cap3.taupathv": {"fn":"tauPath","args":[{"$data":"six-sites","path":"arrays.two"},{"w":{"$setting":"settings.w.equal2"},"family":{"kind":"atMost","G":{"$setting":"settings.cap3"}}}]},
    "six.AB.w50.cap3.tau05": {"fn":"exactOptimum","args":[{"$data":"six-sites","path":"arrays.two"},{"tau":{"$setting":"settings.tau05"},"w":{"$setting":"settings.w.equal2"},"family":{"kind":"atMost","G":{"$setting":"settings.cap3"}}}]},
    "six.AB.w50.cap3.tau10": {"fn":"exactOptimum","args":[{"$data":"six-sites","path":"arrays.two"},{"tau":{"$setting":"settings.tau10"},"w":{"$setting":"settings.w.equal2"},"family":{"kind":"atMost","G":{"$setting":"settings.cap3"}}}]},
    "six.AB.w50.cap3.tau15": {"fn":"exactOptimum","args":[{"$data":"six-sites","path":"arrays.two"},{"tau":{"$setting":"settings.tau15"},"w":{"$setting":"settings.w.equal2"},"family":{"kind":"atMost","G":{"$setting":"settings.cap3"}}}]},
    "six.AB.w50.cap3.tau25": {"fn":"exactOptimum","args":[{"$data":"six-sites","path":"arrays.two"},{"tau":{"$setting":"settings.tau25"},"w":{"$setting":"settings.w.equal2"},"family":{"kind":"atMost","G":{"$setting":"settings.cap3"}}}]},
    "six.AB.w50.cap3.tau30": {"fn":"exactOptimum","args":[{"$data":"six-sites","path":"arrays.two"},{"tau":{"$setting":"settings.tau30"},"w":{"$setting":"settings.w.equal2"},"family":{"kind":"atMost","G":{"$setting":"settings.cap3"}}}]},
    "six.AB.w50.cap3.tau35": {"fn":"exactOptimum","args":[{"$data":"six-sites","path":"arrays.two"},{"tau":{"$setting":"settings.tau35"},"w":{"$setting":"settings.w.equal2"},"family":{"kind":"atMost","G":{"$setting":"settings.cap3"}}}]},
    "six.AB.w50.cap3.tau40": {"fn":"exactOptimum","args":[{"$data":"six-sites","path":"arrays.two"},{"tau":{"$setting":"settings.tau40"},"w":{"$setting":"settings.w.equal2"},"family":{"kind":"atMost","G":{"$setting":"settings.cap3"}}}]}
  },
  "keys": {
    "six.AB.e.BC": {"type":"vector","fn":"rankSummaries","args":[{"states":[[{"$input":"six.AB.errors","path":"e.0.1.2"},{"$input":"six.AB.errors","path":"e.1.1.2"}]],"probs":null}],"field":"means","format":{"fn":"formatTuple","item":{"fn":"formatProb","options":{"digits":4}}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"e_BC on score A and on score B"},
    "six.AB.e.BD": {"type":"vector","fn":"rankSummaries","args":[{"states":[[{"$input":"six.AB.errors","path":"e.0.1.3"},{"$input":"six.AB.errors","path":"e.1.1.3"}]],"probs":null}],"field":"means","format":{"fn":"formatTuple","item":{"fn":"formatProb","options":{"digits":4}}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"e_BD on score A and on score B"},
    "six.AB.conflicts": {"type":"scalar","fn":"conflictPairs","args":[{"$data":"six-sites","path":"arrays.two"},{}],"field":"count","format":{"fn":"formatCount"},"tolerance":0},
    "six.AB.w50.cap3.tau20.grades": {"type":"vector","from":"six.AB.w50.cap3.tau20","field":"grade","format":{"fn":"formatGrades"},"tolerance":0},
