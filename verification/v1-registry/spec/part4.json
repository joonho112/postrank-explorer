    "six.AB.w50.ebar.BC": {"type":"scalar","from":"six.AB.w50.ebar","field":"1.2","format":{"fn":"formatProb"},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "six.AB.w50.all.tau20.grades": {"type":"vector","from":"six.AB.w50.all.tau20","field":"grade","format":{"fn":"formatGrades"},"tolerance":0},
