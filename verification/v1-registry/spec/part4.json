    "six.AB.w50.cap3.tau20.risk": {"type":"scalar","from":"six.AB.w50.cap3.tau20","field":"risk","format":{"fn":"formatRisk"},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "six.AB.w50.cap3.tau20.EoverN": {"type":"vector","from":"six.AB.w50.cap3.tau20","field":"EoverN","format":{"fn":"formatTuple","item":{"fn":"formatEoverN","options":{"digits":4}}},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "six.AB.w50.cap3.tau20.Rk": {"type":"vector","from":"six.AB.w50.cap3.tau20","field":"evaluation.Rk","format":{"fn":"formatTuple","item":{"fn":"formatRisk"}},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "six.AB.w50.cap3.tau20.wE": {"type":"scalar","from":"six.AB.w50.cap3.tau20","field":"Ew","format":{"fn":"formatRisk"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"sum_k w_k E_k"},
    "six.AB.w50.cap3.tau20.tauN": {"type":"scalar","fn":"budgetCheck","args":[{"$input":"six.AB.w50.cap3.tau20","path":"grade"},{"$data":"six-sites","path":"arrays.two"},[{"$setting":"settings.tau20"},{"$setting":"settings.tau20"}]],"field":"rows.0.qN","format":{"fn":"formatDecimal","options":{"digits":1}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"tau N (the budget check with q = tau)"},
