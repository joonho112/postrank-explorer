    "m2.state.tau30.costs": {"type":"vector","fn":"rankSummaries","args":[{"states":[[{"$input":"m2.state.tau30","path":"criterionLoss.costs.iAboveJ"},{"$input":"m2.state.tau30","path":"criterionLoss.costs.jAboveI"},{"$input":"m2.state.tau30","path":"criterionLoss.costs.withhold"}]],"probs":null}],"field":"means","format":{"fn":"formatTuple","item":{"fn":"formatRational"}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"criterion-direction costs of A above B, B above A, withholding","settings":{"w":"settings.w75","a":"settings.w.equal2","tau":"settings.tau30"}},
    "m2.state.composite": {"type":"vector","from":"m2.state.tau30","field":"c","format":{"fn":"formatTuple","item":{"fn":"formatRational"}},"tolerance":{"abs":1e-12,"rel":1e-12},"settings":{"w":"settings.w75","a":"settings.w.equal2","tau":"settings.tau30"},"note":"composite c_i with a = (1/2, 1/2)"},
    "m2.state.scale25.composite": {"type":"vector","fn":"estimandCosts","args":[[[1,-2],[0,0]],{"w":{"$setting":"settings.w75"},"a":{"$setting":"settings.w.equal2"},"tau":{"$setting":"settings.tau30"},"multiplier":[1,0.25]}],"field":"c","format":{"fn":"formatTuple","item":{"fn":"formatRational"}},"tolerance":{"abs":1e-12,"rel":1e-12},"settings":{"w":"settings.w75","a":"settings.w.equal2","tau":"settings.tau30"},"note":"criterion 2 multiplied by 1/4"},
