{
  "$schema": "../schema.json",
  "spec": "part1-l02",
  "description": "L-02 (One number, two parts, pages/learn/noisy-estimate.qmd): the settings of its prediction and presets, the seeded estimates of one unit (simulateEstimates; the noise and its size in SEs from the same stream with true value 0), the counts of estimates within one SE of the true value (evidenceFlags with crit 1 leaves them unflagged; read as the size of the middle canonical grade through disclosure, so each key names the field that holds that group at its setting), the share Phi(1) - Phi(-1) to four decimals, and the counts expected on average, draws x (Phi(1) - Phi(-1)), written as the mean of a two-state law with values draws and -draws.",
  "license_scope": "author",
  "inputs": {
    "l02.cdf1": {"fn":"normalCdf","args":[1]},
    "l02.sf1": {"fn":"normalSf","args":[1]},
    "l02.q.est": {"fn":"simulateEstimates","args":[{"$setting":"settings.l02.truth50"},{"$setting":"settings.l02.se20"},{"$setting":"settings.l02.draws20"},{"$setting":"settings.seed.s1"}],"note":"the prediction's setting and preset se20: true value .50, SE .20, 20 draws, seed 1"},
    "l02.q.flags": {"fn":"evidenceFlags","args":[{"$input":"l02.q.est"},{"$setting":"settings.l02.se20"},{"ref":{"$setting":"settings.l02.truth50"},"crit":1}]},
    "l02.se10.est": {"fn":"simulateEstimates","args":[{"$setting":"settings.l02.truth50"},{"$setting":"settings.l02.se10"},{"$setting":"settings.l02.draws20"},{"$setting":"settings.seed.s1"}],"note":"preset se10"},
    "l02.se10.flags": {"fn":"evidenceFlags","args":[{"$input":"l02.se10.est"},{"$setting":"settings.l02.se10"},{"ref":{"$setting":"settings.l02.truth50"},"crit":1}]},
    "l02.se05.est": {"fn":"simulateEstimates","args":[{"$setting":"settings.l02.truth50"},{"$setting":"settings.l02.se05"},{"$setting":"settings.l02.draws20"},{"$setting":"settings.seed.s1"}],"note":"preset se05"},
    "l02.se05.flags": {"fn":"evidenceFlags","args":[{"$input":"l02.se05.est"},{"$setting":"settings.l02.se05"},{"ref":{"$setting":"settings.l02.truth50"},"crit":1}]},
    "l02.n200.est": {"fn":"simulateEstimates","args":[{"$setting":"settings.l02.truth50"},{"$setting":"settings.l02.se20"},{"$setting":"settings.l02.draws200"},{"$setting":"settings.seed.s1"}],"note":"the prediction's unit after 200 draws (the widget's maximum)"},
    "l02.n200.flags": {"fn":"evidenceFlags","args":[{"$input":"l02.n200.est"},{"$setting":"settings.l02.se20"},{"ref":{"$setting":"settings.l02.truth50"},"crit":1}]},
    "l02.share.law": {"fn":"rankSummaries","args":[{"states":[[1],[-1]],"probs":[{"$input":"l02.cdf1"},{"$input":"l02.sf1"}]}],"note":"Phi(1) - Phi(-1), the share of normal noise within one SE, written as the mean of a two-state law with values 1 and -1"},
    "l02.n200.law": {"fn":"rankSummaries","args":[{"states":[[200],[-200]],"probs":[{"$input":"l02.cdf1"},{"$input":"l02.sf1"}]}],"note":"200 (Phi(1) - Phi(-1)): the expected count of 200 estimates within one SE"},
    "l02.n21.est": {"fn":"simulateEstimates","args":[0.5,0.2,21,1],"note":"one more draw after the prediction's 20 (read-out update case)"},
    "l02.n21.flags": {"fn":"evidenceFlags","args":[{"$input":"l02.n21.est"},0.2,{"ref":0.5,"crit":1}]},
    "l02.n21.law": {"fn":"rankSummaries","args":[{"states":[[21],[-21]],"probs":[{"$input":"l02.cdf1"},{"$input":"l02.sf1"}]}],"note":"21 (Phi(1) - Phi(-1))"},
    "l02.n7.est": {"fn":"simulateEstimates","args":[-0.3,0.05,7,20261030],"note":"the setting of the base-R oracle row simulateEstimates-truth-0.3-se0.05-n7-seed20261030 (read-out raw query)"},
    "l02.n7.flags": {"fn":"evidenceFlags","args":[{"$input":"l02.n7.est"},0.05,{"ref":-0.3,"crit":1}]},
    "l02.n7.law": {"fn":"rankSummaries","args":[{"states":[[7],[-7]],"probs":[{"$input":"l02.cdf1"},{"$input":"l02.sf1"}]}],"note":"7 (Phi(1) - Phi(-1))"},
    "l02.clamp.est": {"fn":"simulateEstimates","args":[1,0.5,200,1],"note":"true value, SE and draws at the slider and draw maximums (read-out clamped case)"},
    "l02.clamp.flags": {"fn":"evidenceFlags","args":[{"$input":"l02.clamp.est"},0.5,{"ref":1,"crit":1}]}
  },
  "keys": {
    "l02.q.within": {"type":"scalar","fn":"disclosure","args":[{"$input":"l02.q.flags","path":"grade"}],"field":"sizes.1","format":{"fn":"formatCount"},"tolerance":0,"note":"estimates within one SE of the 20 drawn at the prediction's setting: the unflagged group is the middle grade (some estimates are flagged above and some below)"},
    "l02.q.latest": {"type":"scalar","from":"l02.q.est","field":"19","format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"the 20th estimate"},
    "l02.q.noise": {"type":"scalar","fn":"simulateEstimates","args":[0,{"$setting":"settings.l02.se20"},{"$setting":"settings.l02.draws20"},{"$setting":"settings.seed.s1"}],"field":"19","format":{"fn":"formatSigned","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"the noise of the 20th estimate: the same draw with true value 0"},
    "l02.n20.z": {"type":"scalar","fn":"normals","args":[{"$setting":"settings.seed.s1"},{"$setting":"settings.l02.draws20"}],"field":"19","format":{"fn":"formatSigned","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"the noise of the 20th draw in SEs (the same for every true value and SE)"},
    "l02.se10.within": {"type":"scalar","fn":"disclosure","args":[{"$input":"l02.se10.flags","path":"grade"}],"field":"sizes.1","format":{"fn":"formatCount"},"tolerance":0},
    "l02.se10.latest": {"type":"scalar","from":"l02.se10.est","field":"19","format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "l02.se10.noise": {"type":"scalar","fn":"simulateEstimates","args":[0,{"$setting":"settings.l02.se10"},{"$setting":"settings.l02.draws20"},{"$setting":"settings.seed.s1"}],"field":"19","format":{"fn":"formatSigned","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "l02.se05.within": {"type":"scalar","fn":"disclosure","args":[{"$input":"l02.se05.flags","path":"grade"}],"field":"sizes.1","format":{"fn":"formatCount"},"tolerance":0},
    "l02.se05.latest": {"type":"scalar","from":"l02.se05.est","field":"19","format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "l02.se05.noise": {"type":"scalar","fn":"simulateEstimates","args":[0,{"$setting":"settings.l02.se05"},{"$setting":"settings.l02.draws20"},{"$setting":"settings.seed.s1"}],"field":"19","format":{"fn":"formatSigned","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "l02.share.within1": {"type":"scalar","from":"l02.share.law","field":"means.0","format":{"fn":"formatProb","options":{"digits":4}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"the share expected within one SE, Phi(1) - Phi(-1), to four decimals (N-03): .6827 times 20 draws is the 13.65 shown beside it, where .683 times 20 would not be"},
    "l02.n200.within": {"type":"scalar","fn":"disclosure","args":[{"$input":"l02.n200.flags","path":"grade"}],"field":"sizes.1","format":{"fn":"formatCount"},"tolerance":0},
    "l02.n200.expected": {"type":"scalar","from":"l02.n200.law","field":"means.0","format":{"fn":"formatDecimal","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "l02.n200.latest": {"type":"scalar","from":"l02.n200.est","field":"199","format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "l02.n21.within": {"type":"scalar","fn":"disclosure","args":[{"$input":"l02.n21.flags","path":"grade"}],"field":"sizes.1","format":{"fn":"formatCount"},"tolerance":0},
    "l02.n21.expected": {"type":"scalar","from":"l02.n21.law","field":"means.0","format":{"fn":"formatDecimal","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "l02.n21.latest": {"type":"scalar","from":"l02.n21.est","field":"20","format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "l02.n21.z": {"type":"scalar","fn":"normals","args":[1,21],"field":"20","format":{"fn":"formatSigned","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "l02.n7.within": {"type":"scalar","fn":"disclosure","args":[{"$input":"l02.n7.flags","path":"grade"}],"field":"sizes.0","format":{"fn":"formatCount"},"tolerance":0,"note":"no estimate is flagged above at this setting, so the unflagged group is grade 1"},
    "l02.n7.expected": {"type":"scalar","from":"l02.n7.law","field":"means.0","format":{"fn":"formatDecimal","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "l02.n7.noise": {"type":"scalar","fn":"simulateEstimates","args":[0,0.05,7,20261030],"field":"6","format":{"fn":"formatSigned","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "l02.n7.z": {"type":"scalar","fn":"normals","args":[20261030,7],"field":"6","format":{"fn":"formatSigned","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "l02.clamp.within": {"type":"scalar","fn":"disclosure","args":[{"$input":"l02.clamp.flags","path":"grade"}],"field":"sizes.1","format":{"fn":"formatCount"},"tolerance":0},
    "l02.clamp.latest": {"type":"scalar","from":"l02.clamp.est","field":"199","format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12}}
  }
}
