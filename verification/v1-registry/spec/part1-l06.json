{
  "$schema": "../schema.json",
  "spec": "part1-l06",
  "description": "Part 1, Intervals do not decide directions (L-06, pages/learn/interval-overlap.qmd, a Deeper page): closed forms for two independent normal posteriors with SD 1 whose 90% or 95% intervals just touch (the half-width, the distance between the posterior means, the SD of the difference, the distance in SDs of the difference, the bound for intervals that do not overlap), and the simulated league's frozen draw (seed 20261030) under the teaching posterior at prior SD .15: pairs whose intervals do not overlap, pairs with no direction above .90, and three named pairs. The two settings of the page (the .90 split and the .99 bound) sit here for the integrator to move.",
  "license_scope": "author",
  "inputs": {
    "l06.z90": {"fn":"normalInterval","args":[0,1,{"$setting":"settings.level90"}],"note":"a central 90% interval of a posterior with mean 0 and SD 1: its upper end is the half-width z, in posterior SDs"},
    "l06.z95": {"fn":"normalInterval","args":[0,1,{"$setting":"settings.level95"}],"note":"the same at 95%"},
    "l06.touch90": {"fn":"normalInterval","args":[{"$input":"l06.z90","path":"upper"},1,{"$setting":"settings.level90"}],"note":"an interval centred on B's upper end z: its upper end 2z is A's posterior mean when A's lower end meets B's upper end (the intervals just touch)"},
    "l06.touch95": {"fn":"normalInterval","args":[{"$input":"l06.z95","path":"upper"},1,{"$setting":"settings.level95"}],"note":"the same at 95%"},
    "l06.touch90.A": {"fn":"normalInterval","args":[{"$input":"l06.touch90","path":"upper"},1,{"$setting":"settings.level90"}],"note":"A's 90% interval at the touching distance: from z to 3z"},
    "l06.touch95.A": {"fn":"normalInterval","args":[{"$input":"l06.touch95","path":"upper"},1,{"$setting":"settings.level95"}],"note":"A's 95% interval at the touching distance"},
    "l06.touch90.pi": {"fn":"pairDirection","args":[{"$input":"l06.touch90","path":"upper"},1,0,1],"note":"the probability that A's true value is larger than B's at the touching distance (as cf.touch.level90.pi)"},
    "l06.touch95.pi": {"fn":"pairDirection","args":[{"$input":"l06.touch95","path":"upper"},1,0,1],"note":"the same at 95% (as cf.touch.level95.pi)"},
    "l06.diffsd.pi": {"fn":"pairDirection","args":[2,1,0,1],"note":"Phi(v / sqrt(v)) with v = 1^2 + 1^2 = 2, so Phi^-1 of it is the SD of the difference of two independent posteriors with SD 1"},
    "l06.cdf90": {"fn":"normalCdf","args":[{"$input":"l06.z90","path":"upper"}],"note":"the chance that a unit's true value lies below its 90% interval's upper end"},
    "l06.sf90": {"fn":"normalSf","args":[{"$input":"l06.z90","path":"upper"}],"note":"the chance that it lies above that end"},
    "l06.both90.law": {"fn":"rankSummaries","args":[{"states":[[{"$input":"l06.cdf90"}],[0]],"probs":[{"$input":"l06.cdf90"},{"$input":"l06.sf90"}]}],"note":"Phi(z) * Phi(z) + (1 - Phi(z)) * 0 = Phi(z)^2: the chance that A lies above the touching point and B below it"},
    "l06.league": {"fn":"league30","args":[]},
    "l06.post15": {"fn":"normalPosterior","args":[{"$data":"league-30","path":"tables.units.estimate"},{"$data":"league-30","path":"tables.units.se"},{"priorSd":{"$setting":"settings.prior15"}}],"note":"the frozen draw (seed 20261030) under the teaching posterior, prior mean 0, prior SD .15"},
    "l06.iv15": {"fn":"normalInterval","args":[{"$input":"l06.post15","path":"mean"},{"$input":"l06.post15","path":"sd"},{"$setting":"settings.level90"}],"note":"the thirty 90% posterior intervals"},
    "l06.iv15.95": {"fn":"normalInterval","args":[{"$input":"l06.post15","path":"mean"},{"$input":"l06.post15","path":"sd"},{"$setting":"settings.level95"}],"note":"the thirty 95% posterior intervals"},
    "l06.iv15.up": {"fn":"normalInterval","args":[{"$input":"l06.iv15","path":"upper"},1,{"$setting":"settings.level90"}],"note":"every 90% upper end shifted up by 1.645, above every lower end of the league (the ends span less than .70)"},
    "l06.iv15.95.up": {"fn":"normalInterval","args":[{"$input":"l06.iv15.95","path":"upper"},1,{"$setting":"settings.level95"}],"note":"every 95% upper end shifted up by 1.960, above every lower end (the ends span less than .76)"},
    "l06.rank15": {"fn":"strictOrder","args":[{"$input":"l06.post15","path":"mean"}],"note":"the posterior-mean order, 1 = largest posterior mean"},
    "l06.E15": {"fn":"errorArray","args":[{"$input":"l06.post15","path":"mean"},{"$input":"l06.post15","path":"sd"}],"note":"e_ij = Pr(theta_i <= theta_j | Y) = 1 - pi_ij for the thirty posteriors"},
    "l06.pi15": {"fn":"directionMatrix","args":[{"$input":"l06.post15","path":"mean"},{"$input":"l06.post15","path":"sd"}],"note":"pi_ij = Pr(theta_i > theta_j | Y) for the thirty posteriors"},
    "l06.tally15.90": {"fn":"intervalOverlapTally","args":[{"$input":"l06.iv15","path":"lower"},{"$input":"l06.iv15","path":"upper"},{"$input":"l06.pi15"},{"threshold":{"$setting":"settings.l06.pi90"}}],"note":"every pair of league units by its 90% intervals (apart, or overlapping with max(pi_ij, pi_ji) above .90 or at most .90)"},
    "l06.tally15.95": {"fn":"intervalOverlapTally","args":[{"$input":"l06.iv15.95","path":"lower"},{"$input":"l06.iv15.95","path":"upper"},{"$input":"l06.pi15"},{"threshold":{"$setting":"settings.l06.pi90"}}],"note":"the same with 95% intervals"}
  },
  "keys": {
    "cf.touch.level90.end": {"type":"scalar","from":"l06.z90","field":"upper","format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"the half-width of a 90% interval in posterior SDs (B's upper end; also A's lower end when the intervals touch)"},
    "cf.touch.level95.end": {"type":"scalar","from":"l06.z95","field":"upper","format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"the half-width of a 95% interval in posterior SDs"},
    "cf.touch.level90.gap": {"type":"scalar","from":"l06.touch90","field":"upper","format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"the distance between the posterior means of two equal-SD 90% intervals that just touch, in posterior SDs (2z)"},
    "cf.touch.level95.gap": {"type":"scalar","from":"l06.touch95","field":"upper","format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"the same for 95% intervals"},
    "cf.touch.level90.Aupper": {"type":"scalar","from":"l06.touch90.A","field":"upper","format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"the upper end of A's 90% interval at the touching distance (3z)"},
    "cf.touch.level95.Aupper": {"type":"scalar","from":"l06.touch95.A","field":"upper","format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"the upper end of A's 95% interval at the touching distance"},
    "cf.touch.diffsd": {"type":"scalar","fn":"normalQuantile","args":[{"$input":"l06.diffsd.pi"}],"format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"the SD of A minus B for two independent posteriors with SD 1: sqrt 2"},
    "cf.touch.level90.z": {"type":"scalar","fn":"normalQuantile","args":[{"$input":"l06.touch90.pi"}],"format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"the touching distance in SDs of the difference: 2z / sqrt 2"},
    "cf.touch.level95.z": {"type":"scalar","fn":"normalQuantile","args":[{"$input":"l06.touch95.pi"}],"format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"the same at 95%"},
    "cf.apart.level90.bound": {"type":"scalar","from":"l06.cdf90","format":{"fn":"formatProb","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"the direction probability that 90% intervals of independent normal posteriors exceed when they do not overlap, whatever the two SDs; also the chance that A lies above the touching point"},
    "cf.apart.level95.bound": {"type":"scalar","fn":"normalCdf","args":[{"$input":"l06.z95","path":"upper"}],"format":{"fn":"formatProb"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"the same bound for 95% intervals"},
    "cf.touch.level90.both": {"type":"scalar","from":"l06.both90.law","field":"means.0","format":{"fn":"formatProb","options":{"digits":4}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"the chance that A lies above the touching point and B below it, .95 squared"},
    "cf.touch.gap2.pi": {"type":"scalar","from":"l06.diffsd.pi","format":{"fn":"formatProb"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"the probability that A's true value is larger than B's when the posterior means are 2 posterior SDs apart (read-out raw query)"},
    "cf.touch.gap2.level90.Alower": {"type":"scalar","fn":"normalInterval","args":[2,1,{"$setting":"settings.level90"}],"field":"lower","format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"A's 90% lower end at distance 2"},
    "cf.touch.gap2.level90.Aupper": {"type":"scalar","fn":"normalInterval","args":[2,1,{"$setting":"settings.level90"}],"field":"upper","format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"A's 90% upper end at distance 2"},
