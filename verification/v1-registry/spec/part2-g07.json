{
  "$schema": "../schema.json",
  "spec": "part2-g07",
  "description": "Part 2, Reading a report card (G-07): the six-site card at tau = .20 with at most 3 grades (exact optimum) and the 30-site example's poverty card at tau = .25 with at most 4 grades (optimal within the expected-rank order): G(g), s, grade-average posterior means, the pair counts between grades, the largest stated error, the 30-site row orders of the four sorts and one interval. The card's N, risk, E/N, sizes, between-grade shares and family sizes are six.A.cap3.tau20.*, six.family.cap3.size and thirty.poverty.* in part2.json.",
  "license_scope": "author",
  "inputs": {
    "g07.six": {"fn":"exactOptimum","args":[{"$data":"six-sites","path":"arrays.one"},{"tau":{"$setting":"settings.tau20"},"family":{"kind":"atMost","G":{"$setting":"settings.cap3"}}}],"note":"the card of the prediction and of the six-site presets (the same input as six.A.cap3.tau20 in part2.json)"},
    "g07.thirty.exprank": {"fn":"expectedRank","args":[{"ids":{"$data":"thirty-sites","path":"arrays.gaussian.ids"},"criteria":["poverty"],"e":[{"$data":"thirty-sites","path":"arrays.gaussian.e.0"}]},{}],"note":"the poverty criterion's expected ranks (the same input as thirty.poverty.exprank)"},
    "g07.thirty": {"fn":"fixedOrderDP","args":[{"ids":{"$data":"thirty-sites","path":"arrays.gaussian.ids"},"criteria":["poverty"],"e":[{"$data":"thirty-sites","path":"arrays.gaussian.e.0"}]},{"scores":{"$input":"g07.thirty.exprank"},"direction":"ascending","G":{"$setting":"settings.cap4"},"tau":{"$setting":"settings.tau25"}}],"note":"the 30-site preset's card; postrank_cuts(rule = 'optimal') and postrank() with weights poverty = 1 give the same grades (checked in R)"},
    "g07.thirty.disc": {"fn":"disclosure","args":[{"$input":"g07.thirty","path":"grade"}]},
    "g07.thirty.between": {"fn":"betweenGradeErrors","args":[{"$input":"g07.thirty","path":"grade"},{"ids":{"$data":"thirty-sites","path":"arrays.gaussian.ids"},"criteria":["poverty"],"e":[{"$data":"thirty-sites","path":"arrays.gaussian.e.0"}]},{}]},
    "g07.six.between": {"fn":"betweenGradeErrors","args":[{"$input":"g07.six","path":"grade"},{"$data":"six-sites","path":"arrays.one"},{}]}
  },
  "keys": {
    "g07.six.cap3.tau20.G": {"type":"scalar","from":"g07.six","field":"G","format":{"fn":"formatCount"},"tolerance":0,"note":"G(g) of the six-site card 1/1/2/2/3/3"},
    "g07.six.cap3.tau20.grade1.N": {"type":"scalar","fn":"disclosure","args":[[1,1,2,2,2,2]],"field":"N","format":{"fn":"formatCount"},"tolerance":0,"note":"the directions grade 1 of the six-site card 1/1/2/2/3/3 states on its own (A and B above the other four sites): the N of the report that keeps grade 1 and puts every other site in one grade"},
    "g07.six.cap3.tau20.gmean1": {"type":"scalar","fn":"summaryStats","args":[[{"$data":"six-sites","path":"tables.units.mean_A.0"},{"$data":"six-sites","path":"tables.units.mean_A.1"}]],"field":"mean","format":{"fn":"formatDecimal","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"grade 1's average posterior mean (sites A, B of the card 1/1/2/2/3/3)"},
    "g07.six.cap3.tau20.gmean2": {"type":"scalar","fn":"summaryStats","args":[[{"$data":"six-sites","path":"tables.units.mean_A.2"},{"$data":"six-sites","path":"tables.units.mean_A.3"}]],"field":"mean","format":{"fn":"formatDecimal","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"grade 2's average posterior mean (sites C, D of the card 1/1/2/2/3/3)"},
    "g07.six.cap3.tau20.gmean3": {"type":"scalar","fn":"summaryStats","args":[[{"$data":"six-sites","path":"tables.units.mean_A.4"},{"$data":"six-sites","path":"tables.units.mean_A.5"}]],"field":"mean","format":{"fn":"formatDecimal","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"grade 3's average posterior mean (sites E, F of the card 1/1/2/2/3/3)"},
    "g07.six.cap3.tau20.pairs12": {"type":"scalar","from":"g07.six.between","field":"0.pairs","format":{"fn":"formatCount"},"tolerance":0,"note":"stated pairs between grades 1 and 2"},
    "g07.six.cap3.tau20.pairs13": {"type":"scalar","from":"g07.six.between","field":"1.pairs","format":{"fn":"formatCount"},"tolerance":0,"note":"stated pairs between grades 1 and 3"},
    "g07.six.cap3.tau20.pairs23": {"type":"scalar","from":"g07.six.between","field":"2.pairs","format":{"fn":"formatCount"},"tolerance":0,"note":"stated pairs between grades 2 and 3"},
    "g07.thirty.cap4.tau25.G": {"type":"scalar","from":"g07.thirty.disc","field":"G","format":{"fn":"formatCount"},"tolerance":0},
    "g07.thirty.cap4.tau25.s": {"type":"scalar","from":"g07.thirty.disc","field":"s","format":{"fn":"formatShare"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"s = N/M = 303/435"},
    "g07.thirty.cap4.tau25.gmean1": {"type":"scalar","fn":"summaryStats","args":[[{"$data":"thirty-sites","path":"tables.units.mean_poverty.2"},{"$data":"thirty-sites","path":"tables.units.mean_poverty.9"},{"$data":"thirty-sites","path":"tables.units.mean_poverty.26"},{"$data":"thirty-sites","path":"tables.units.mean_poverty.27"},{"$data":"thirty-sites","path":"tables.units.mean_poverty.28"}]],"field":"mean","format":{"fn":"formatDecimal","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"grade 1's average posterior mean (unit indices 2, 9, 26, 27, 28 of the card)"},
    "g07.thirty.cap4.tau25.gmean2": {"type":"scalar","fn":"summaryStats","args":[[{"$data":"thirty-sites","path":"tables.units.mean_poverty.4"},{"$data":"thirty-sites","path":"tables.units.mean_poverty.7"},{"$data":"thirty-sites","path":"tables.units.mean_poverty.10"},{"$data":"thirty-sites","path":"tables.units.mean_poverty.11"},{"$data":"thirty-sites","path":"tables.units.mean_poverty.16"},{"$data":"thirty-sites","path":"tables.units.mean_poverty.17"},{"$data":"thirty-sites","path":"tables.units.mean_poverty.18"},{"$data":"thirty-sites","path":"tables.units.mean_poverty.20"},{"$data":"thirty-sites","path":"tables.units.mean_poverty.22"},{"$data":"thirty-sites","path":"tables.units.mean_poverty.24"},{"$data":"thirty-sites","path":"tables.units.mean_poverty.29"}]],"field":"mean","format":{"fn":"formatDecimal","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"grade 2's average posterior mean (unit indices 4, 7, 10, 11, 16, 17, 18, 20, 22, 24, 29 of the card)"},
    "g07.thirty.cap4.tau25.gmean3": {"type":"scalar","fn":"summaryStats","args":[[{"$data":"thirty-sites","path":"tables.units.mean_poverty.0"},{"$data":"thirty-sites","path":"tables.units.mean_poverty.1"},{"$data":"thirty-sites","path":"tables.units.mean_poverty.3"},{"$data":"thirty-sites","path":"tables.units.mean_poverty.5"},{"$data":"thirty-sites","path":"tables.units.mean_poverty.12"},{"$data":"thirty-sites","path":"tables.units.mean_poverty.13"},{"$data":"thirty-sites","path":"tables.units.mean_poverty.14"},{"$data":"thirty-sites","path":"tables.units.mean_poverty.15"},{"$data":"thirty-sites","path":"tables.units.mean_poverty.19"},{"$data":"thirty-sites","path":"tables.units.mean_poverty.21"},{"$data":"thirty-sites","path":"tables.units.mean_poverty.23"},{"$data":"thirty-sites","path":"tables.units.mean_poverty.25"}]],"field":"mean","format":{"fn":"formatDecimal","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"grade 3's average posterior mean (unit indices 0, 1, 3, 5, 12, 13, 14, 15, 19, 21, 23, 25 of the card)"},
    "g07.thirty.cap4.tau25.gmean4": {"type":"scalar","fn":"summaryStats","args":[[{"$data":"thirty-sites","path":"tables.units.mean_poverty.6"},{"$data":"thirty-sites","path":"tables.units.mean_poverty.8"}]],"field":"mean","format":{"fn":"formatDecimal","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"grade 4's average posterior mean (unit indices 6, 8 of the card)"},
    "g07.thirty.cap4.tau25.pairs12": {"type":"scalar","from":"g07.thirty.between","field":"0.pairs","format":{"fn":"formatCount"},"tolerance":0,"note":"stated pairs between grades 1 and 2"},
    "g07.thirty.cap4.tau25.pairs13": {"type":"scalar","from":"g07.thirty.between","field":"1.pairs","format":{"fn":"formatCount"},"tolerance":0,"note":"stated pairs between grades 1 and 3"},
    "g07.thirty.cap4.tau25.pairs14": {"type":"scalar","from":"g07.thirty.between","field":"2.pairs","format":{"fn":"formatCount"},"tolerance":0,"note":"stated pairs between grades 1 and 4"},
    "g07.thirty.cap4.tau25.pairs23": {"type":"scalar","from":"g07.thirty.between","field":"3.pairs","format":{"fn":"formatCount"},"tolerance":0,"note":"stated pairs between grades 2 and 3"},
    "g07.thirty.cap4.tau25.pairs24": {"type":"scalar","from":"g07.thirty.between","field":"4.pairs","format":{"fn":"formatCount"},"tolerance":0,"note":"stated pairs between grades 2 and 4"},
    "g07.thirty.cap4.tau25.pairs34": {"type":"scalar","from":"g07.thirty.between","field":"5.pairs","format":{"fn":"formatCount"},"tolerance":0,"note":"stated pairs between grades 3 and 4"},
    "g07.thirty.cap4.tau25.largest": {"type":"scalar","fn":"statedAbove","args":[{"$input":"g07.thirty","path":"grade"},{"ids":{"$data":"thirty-sites","path":"arrays.gaussian.ids"},"criteria":["poverty"],"e":[{"$data":"thirty-sites","path":"arrays.gaussian.e.0"}]},{"tau":{"$setting":"settings.tau25"}}],"field":"max","format":{"fn":"formatRisk"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"the largest single stated error of the card"},
    "g07.thirty.cap4.tau25.order.grade": {"type":"vector","fn":"reportCardRows","args":[{"$input":"g07.thirty","path":"grade"},{"ids":{"$data":"thirty-sites","path":"arrays.gaussian.ids"},"expectedRank":{"$input":"g07.thirty.exprank"},"mean":{"$data":"thirty-sites","path":"tables.units.mean_poverty"}},"expected_rank"],"format":{"fn":"formatTuple","item":{"fn":"formatCount"}},"tolerance":0,"note":"row order (unit indices) of postrank_plot_report_card(order = 'grade') on this card; checked against postrank 1.1.0 in R; 'grade' keeps the card's stored order, which postrank_report_card() makes by expected rank"},
    "g07.thirty.cap4.tau25.order.expected_rank": {"type":"vector","fn":"reportCardRows","args":[{"$input":"g07.thirty","path":"grade"},{"ids":{"$data":"thirty-sites","path":"arrays.gaussian.ids"},"expectedRank":{"$input":"g07.thirty.exprank"},"mean":{"$data":"thirty-sites","path":"tables.units.mean_poverty"}},"expected_rank"],"format":{"fn":"formatTuple","item":{"fn":"formatCount"}},"tolerance":0,"note":"row order (unit indices) of postrank_plot_report_card(order = 'expected_rank') on this card; checked against postrank 1.1.0 in R"},
    "g07.thirty.cap4.tau25.order.mean": {"type":"vector","fn":"reportCardRows","args":[{"$input":"g07.thirty","path":"grade"},{"ids":{"$data":"thirty-sites","path":"arrays.gaussian.ids"},"expectedRank":{"$input":"g07.thirty.exprank"},"mean":{"$data":"thirty-sites","path":"tables.units.mean_poverty"}},"mean"],"format":{"fn":"formatTuple","item":{"fn":"formatCount"}},"tolerance":0,"note":"row order (unit indices) of postrank_plot_report_card(order = 'mean') on this card; checked against postrank 1.1.0 in R"},
    "g07.thirty.cap4.tau25.order.label": {"type":"vector","fn":"reportCardRows","args":[{"$input":"g07.thirty","path":"grade"},{"ids":{"$data":"thirty-sites","path":"arrays.gaussian.ids"},"expectedRank":{"$input":"g07.thirty.exprank"},"mean":{"$data":"thirty-sites","path":"tables.units.mean_poverty"}},"label"],"format":{"fn":"formatTuple","item":{"fn":"formatCount"}},"tolerance":0,"note":"row order (unit indices) of postrank_plot_report_card(order = 'label') on this card; checked against postrank 1.1.0 in R"},
    "g07.thirty.site029.interval90.lower": {"type":"scalar","fn":"normalInterval","args":[{"$data":"thirty-sites","path":"tables.units.mean_poverty.28"},{"$data":"thirty-sites","path":"tables.units.sd_poverty.28"},{"$setting":"settings.level90"}],"field":"lower","format":{"fn":"formatDecimal","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"site029's 90% interval lower end (the card's first row); postrank_report_card() gives the same (gaussian_analytic)"},
    "g07.thirty.site029.interval90.upper": {"type":"scalar","fn":"normalInterval","args":[{"$data":"thirty-sites","path":"tables.units.mean_poverty.28"},{"$data":"thirty-sites","path":"tables.units.sd_poverty.28"},{"$setting":"settings.level90"}],"field":"upper","format":{"fn":"formatDecimal","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"site029's 90% interval upper end (the card's first row); postrank_report_card() gives the same (gaussian_analytic)"}
  }
}
