  "keys": {
    "cf.normal.above1": {"type":"scalar","fn":"normalSf","args":[1],"format":{"fn":"formatProb"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"Pr(Z > 1)"},
    "cf.normal.within1": {"type":"scalar","from":"cf.normal.within1.law","field":"means.0","format":{"fn":"formatProb"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"Pr(-1 < Z < 1) = Phi(1) - Phi(-1)"},
    "cf.estimate.within1.count20": {"type":"scalar","from":"cf.estimate.within1.count20.law","field":"means.0","format":{"fn":"formatDecimal","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "cf.normal.diffsd": {"type":"scalar","fn":"normalQuantile","args":[{"$input":"cf.normal.diffsd.pi"}],"format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"sqrt(.1^2 + .1^2): Phi^-1(pairDirection(.02, .1, 0, .1))"},
    "cf.touch.level90.pi": {"type":"scalar","fn":"pairDirection","args":[{"$input":"cf.touch.level90.pi.mA","path":"upper"},1,0,1],"format":{"fn":"formatProb"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"equal-SD intervals that just touch: Phi(z sqrt 2)"},
    "cf.touch.level95.pi": {"type":"scalar","fn":"pairDirection","args":[{"$input":"cf.touch.level95.pi.mA","path":"upper"},1,0,1],"format":{"fn":"formatProb"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"equal-SD intervals that just touch: Phi(z sqrt 2)"},
    "cf.pair.p1.pi": {"type":"scalar","fn":"pairDirection","args":[0.3,0.2,0.1,0.2],"format":{"fn":"formatProb"},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "cf.pair.p2.pi": {"type":"scalar","fn":"pairDirection","args":[0.3,0.2,0.1,0.6],"format":{"fn":"formatProb"},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "cf.pair.p3.pi": {"type":"scalar","fn":"pairDirection","args":[0.2,0.2,0.2,0.4],"format":{"fn":"formatProb"},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "cf.pair.p1corr50.pi": {"type":"scalar","fn":"pairDirection","args":[0.3,0.2,0.1,0.2,{"corr":0.5}],"format":{"fn":"formatProb"},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "cf.pair.p1.pi.BA": {"type":"scalar","fn":"pairDirection","args":[0.1,0.2,0.3,0.2],"format":{"fn":"formatProb"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"pi_BA at the L-07 prediction setting (the reverse direction)"},
    "cf.pair.p2.pi.BA": {"type":"scalar","fn":"pairDirection","args":[0.1,0.6,0.3,0.2],"format":{"fn":"formatProb"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"pi_BA at the L-07 preset wide-b"},
    "cf.pair.p3.pi.BA": {"type":"scalar","fn":"pairDirection","args":[0.2,0.4,0.2,0.2],"format":{"fn":"formatProb"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"pi_BA at the L-07 preset equal-means"},
    "cf.pair.p1.onesd.pi": {"type":"scalar","fn":"pairDirection","args":[0.3,0.2,0.1,0],"format":{"fn":"formatProb"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"the L-07 distractor that leaves out unit B's SD: Phi(.20 / .20) = Phi(1)"},
    "cf.pair.p1.onesd.choice": {"type":"scalar","fn":"pairDirection","args":[0.3,0.2,0.1,0],"format":{"fn":"formatProb","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"the L-07 choice .84: Phi(.20 / .20) = Phi(1) to two digits, as the prediction gate shows it"},
    "cf.pair.p1.gap": {"type":"scalar","fn":"normalQuantile","args":[{"$input":"cf.pair.p1.gap.pi"}],"format":{"fn":"formatDecimal","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"posterior mean of the difference A - B at the L-07 prediction setting (also preset wide-b): .30 - .10"},
    "cf.pair.p3.gap": {"type":"scalar","fn":"normalQuantile","args":[{"$input":"cf.pair.p3.gap.pi"}],"format":{"fn":"formatDecimal","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"posterior mean of the difference A - B at the L-07 preset equal-means: .20 - .20"},
    "cf.pair.p1.diffsd": {"type":"scalar","fn":"normalQuantile","args":[{"$input":"cf.pair.p1.diffsd.pi"}],"format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"SD of the difference A - B at the L-07 prediction setting: sqrt(.2^2 + .2^2)"},
    "cf.pair.p2.diffsd": {"type":"scalar","fn":"normalQuantile","args":[{"$input":"cf.pair.p2.diffsd.pi"}],"format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"SD of the difference A - B at the L-07 preset wide-b: sqrt(.2^2 + .6^2)"},
    "cf.pair.p3.diffsd": {"type":"scalar","fn":"normalQuantile","args":[{"$input":"cf.pair.p3.diffsd.pi"}],"format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"SD of the difference A - B at the L-07 preset equal-means: sqrt(.2^2 + .4^2)"},
    "cf.pair.p1.z": {"type":"scalar","fn":"normalQuantile","args":[{"$input":"cf.pair.p1.pi.in"}],"format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"Phi^-1(pi_AB): the gap in SDs of the difference at the L-07 prediction setting, .20 / .283"},
    "cf.pair.p2.z": {"type":"scalar","fn":"normalQuantile","args":[{"$input":"cf.pair.p2.pi.in"}],"format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"Phi^-1(pi_AB) at the L-07 preset wide-b"},
    "cf.pair.p3.z": {"type":"scalar","fn":"normalQuantile","args":[{"$input":"cf.pair.p3.pi.in"}],"format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"Phi^-1(pi_AB) at the L-07 preset equal-means (0: equal means)"},
