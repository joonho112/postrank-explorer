{
  "$schema": "../schema.json",
  "spec": "part1",
  "description": "Part 1 (pages/learn): closed forms, the six sites' direction probabilities, the simulated league (SR-06; frozen draw, seeded replays, closed forms) and browser computations on the KRW race array. Theory-book laws (ch. 9, 10, 19) are literal states and probabilities.",
  "license_scope": "author",
  "inputs": {
    "cf.normal.within1.law": {"fn":"rankSummaries","args":[{"states":[[1],[-1]],"probs":[{"$input":"cf.normal.cdf1"},{"$input":"cf.normal.sf1"}]}],"note":"Phi(1) - Phi(-1) written as the probability-weighted sum Phi(1)*1 + Phi(-1)*(-1)"},
    "cf.normal.cdf1": {"fn":"normalCdf","args":[1]},
    "cf.normal.sf1": {"fn":"normalSf","args":[1]},
    "cf.estimate.within1.count20.law": {"fn":"rankSummaries","args":[{"states":[[20],[-20]],"probs":[{"$input":"cf.normal.cdf1"},{"$input":"cf.normal.sf1"}]}],"note":"20 (Phi(1) - Phi(-1)): the expected count of 20 estimates within one SE"},
    "cf.normal.diffsd.pi": {"fn":"pairDirection","args":[0.02,0.1,0,0.1],"note":"Phi(gap / SD of the difference) with gap = .1^2 + .1^2 = .02, so Phi^-1 of it is the SD of the difference"},
    "cf.pair.p1.pi.in": {"fn":"pairDirection","args":[0.3,0.2,0.1,0.2],"note":"L-07 prediction setting: means .30 and .10, SDs .20 and .20"},
    "cf.pair.p2.pi.in": {"fn":"pairDirection","args":[0.3,0.2,0.1,0.6],"note":"L-07 preset wide-b: means .30 and .10, SDs .20 and .60"},
    "cf.pair.p3.pi.in": {"fn":"pairDirection","args":[0.2,0.2,0.2,0.4],"note":"L-07 preset equal-means: means .20 and .20, SDs .20 and .40"},
    "cf.pair.p1.gap.pi": {"fn":"pairDirection","args":[0.3,1,0.1,0],"note":"Phi((.30 - .10) / 1), so Phi^-1 of it is the gap between the two means"},
    "cf.pair.p3.gap.pi": {"fn":"pairDirection","args":[0.2,1,0.2,0],"note":"Phi((.20 - .20) / 1), so Phi^-1 of it is the gap between the two means"},
    "cf.pair.p1.diffsd.pi": {"fn":"pairDirection","args":[0.08,0.2,0,0.2],"note":"Phi(v / sqrt(v)) = Phi(sqrt(v)) with v = .2^2 + .2^2 = .08, so Phi^-1 of it is the SD of the difference"},
    "cf.pair.p2.diffsd.pi": {"fn":"pairDirection","args":[0.4,0.2,0,0.6],"note":"Phi(sqrt(v)) with v = .2^2 + .6^2 = .40"},
    "cf.pair.p3.diffsd.pi": {"fn":"pairDirection","args":[0.2,0.2,0,0.4],"note":"Phi(sqrt(v)) with v = .2^2 + .4^2 = .20"},
    "cf.touch.level90.pi.zB": {"fn":"normalInterval","args":[0,1,{"$setting":"settings.level90"}],"note":"unit B centred at 0 with SD 1: its upper end"},
    "cf.touch.level90.pi.mA": {"fn":"normalInterval","args":[{"$input":"cf.touch.level90.pi.zB","path":"upper"},1,{"$setting":"settings.level90"}],"note":"unit A's centre, where its lower end meets B's upper end"},
    "cf.touch.level95.pi.zB": {"fn":"normalInterval","args":[0,1,{"$setting":"settings.level95"}],"note":"unit B centred at 0 with SD 1: its upper end"},
    "cf.touch.level95.pi.mA": {"fn":"normalInterval","args":[{"$input":"cf.touch.level95.pi.zB","path":"upper"},1,{"$setting":"settings.level95"}],"note":"unit A's centre, where its lower end meets B's upper end"},
    "six.A.pi": {"fn":"directionMatrix","args":[{"$data":"six-sites","path":"tables.units.mean_A"},{"$data":"six-sites","path":"tables.units.sd_A"}],"note":"pi_ij for the six sites' score A (golden 1 - pr_tutorial$one$e)"},
    "six.A.strict": {"fn":"strictOrder","args":[{"$data":"six-sites","path":"tables.units.mean_A"}]},
    "league.spec": {"fn":"league30","args":[]},
