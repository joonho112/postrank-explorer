    "league.default.post": {"fn":"normalPosterior","args":[{"$data":"league-30","path":"tables.units.estimate"},{"$data":"league-30","path":"tables.units.se"},{"priorSd":{"$setting":"settings.prior15"}}]},
    "league.default.E": {"fn":"errorArray","args":[{"$input":"league.default.post","path":"mean"},{"$input":"league.default.post","path":"sd"},{"ids":{"$data":"league-30","path":"tables.units.id"},"criteria":["theta"]}]},
