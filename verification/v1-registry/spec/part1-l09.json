{
  "$schema": "../schema.json",
  "spec": "part1-l09",
  "description": "Part 1, Which ranking? (L-09, pages/learn/which-ranking.qmd). The theory book's ch. 19 three-unit law (true values (20, 4, 3) with probability .3 and (0, 4, 3) with probability .7): its states and state probabilities (read through a one-state law), posterior means, expected ranks, the probabilities of being first and of being in the top two, A's probability of being last, the direction probabilities of B and C above A, and the pairs that the posterior-mean and expected-rank orders put differently. The ch. 10 law on orders (ABC .51, BCA .48, CBA .01): its order probabilities, direction probabilities, expected ranks and majority-win counts (statedAbove at tau 1/2 counts the pairs a unit wins with probability above one half). The simulated league (frozen draw, seed 20261030) under the teaching posterior at prior SD .15: exact expected ranks (expectedRank of the normal ErrorArray), the pairs that the posterior-mean and expected-rank orders put differently, and Monte Carlo top-group probabilities from rankSummariesMC with 4,000 draws at seed 1. Indices are 0-based unit positions (A = 0; U01 = 0).",
  "license_scope": "author",
  "inputs": {
    "l09.law3": {"fn": "rankSummaries", "args": [{"states": [[20, 4, 3], [0, 4, 3]], "probs": [0.3, 0.7]}], "note": "theory book ch. 19 three-unit law (the two coincident criteria written as one)"},
    "l09.law3.high": {"fn": "rankSummaries", "args": [{"states": [[20, 4, 3]], "probs": null}], "note": "the state with a large A, read through a one-state law (its means are the state's values)"},
    "l09.law3.low": {"fn": "rankSummaries", "args": [{"states": [[0, 4, 3]], "probs": null}], "note": "the state with a small A"},
    "l09.law3.probs": {"fn": "rankSummaries", "args": [{"states": [[0.3, 0.7]], "probs": null}], "note": "the two state probabilities, read through a one-state law"},
    "l09.law3.pair": {"fn": "finiteLawPairwise", "args": [[[[20], [4], [3]], [[0], [4], [3]]], [0.3, 0.7], {"ids": ["A", "B", "C"]}], "note": "direction probabilities pi of the same law"},
    "l09.law3.errank": {"fn": "rankSummaries", "args": [{"states": [{"$input": "l09.law3", "path": "expectedRank"}], "probs": null}], "note": "the descending rank of the expected ranks: a larger value means a better expected rank, so it orders units in the same direction as the posterior mean"},
    "l09.law051": {"fn": "rankSummaries", "args": [{"states": [[3, 2, 1], [1, 3, 2], [1, 2, 3]], "probs": [0.51, 0.48, 0.01]}], "note": "theory book ch. 10: orders ABC .51, BCA .48, CBA .01 (values encode the order only)"},
    "l09.law051.probs": {"fn": "rankSummaries", "args": [{"states": [[0.51, 0.48, 0.01]], "probs": null}], "note": "the three order probabilities, read through a one-state law"},
    "l09.law051.pair": {"fn": "finiteLawPairwise", "args": [[[[3], [2], [1]], [[1], [3], [2]], [[1], [2], [3]]], [0.51, 0.48, 0.01], {"ids": ["A", "B", "C"]}]},
    "l09.law051.wins.A": {"fn": "statedAbove", "args": [[2, 1, 1], {"$input": "l09.law051.pair"}, {"tau": {"$setting": "settings.tau50"}}], "note": "B and C stated above A; a stated pair with error above 1/2 is a pair A wins with probability above one half"},
    "l09.law051.wins.B": {"fn": "statedAbove", "args": [[1, 2, 1], {"$input": "l09.law051.pair"}, {"tau": {"$setting": "settings.tau50"}}]},
    "l09.law051.wins.C": {"fn": "statedAbove", "args": [[1, 1, 2], {"$input": "l09.law051.pair"}, {"tau": {"$setting": "settings.tau50"}}]},
    "l09.league.post": {"fn": "normalPosterior", "args": [{"$data": "league-30", "path": "tables.units.estimate"}, {"$data": "league-30", "path": "tables.units.se"}, {"priorSd": {"$setting": "settings.prior15"}}], "note": "the frozen draw, teaching posterior with prior mean 0 and prior SD .15"},
    "l09.league.E": {"fn": "errorArray", "args": [{"$input": "l09.league.post", "path": "mean"}, {"$input": "l09.league.post", "path": "sd"}], "note": "e_ij = Pr(theta_i <= theta_j | Y) for independent normal posteriors"},
    "l09.league.er": {"fn": "expectedRank", "args": [{"$input": "l09.league.E"}], "note": "exact expected rank 1 + sum_j e_ij (postrank_expected_rank)"},
    "l09.league.errank": {"fn": "rankSummaries", "args": [{"states": [{"$input": "l09.league.er"}], "probs": null}], "note": "the descending rank of the expected ranks (larger = better expected rank)"},
    "l09.league.post05": {"fn": "normalPosterior", "args": [{"$data": "league-30", "path": "tables.units.estimate"}, {"$data": "league-30", "path": "tables.units.se"}, {"priorSd": {"$setting": "settings.prior05"}}], "note": "the same draw, teaching posterior at prior SD .05"},
    "l09.league.E05": {"fn": "errorArray", "args": [{"$input": "l09.league.post05", "path": "mean"}, {"$input": "l09.league.post05", "path": "sd"}]},
    "l09.league.er05": {"fn": "expectedRank", "args": [{"$input": "l09.league.E05"}]},
    "l09.league.errank05": {"fn": "rankSummaries", "args": [{"states": [{"$input": "l09.league.er05"}], "probs": null}]},
    "l09.league.mc": {"fn": "rankSummariesMC", "args": [{"$input": "l09.league.post", "path": "mean"}, {"$input": "l09.league.post", "path": "sd"}, {"$setting": "settings.S4000"}, {"$setting": "settings.seed.s1"}], "note": "Monte Carlo rank summaries, 4,000 draws, seed 1"},
    "l09.law3.ri90": {"fn": "rankIntervals", "args": [{"$input": "l09.law3", "path": "pTop"}, {"level": {"$setting": "settings.level90"}}], "note": "90% rank intervals of the ch. 19 law (exact)"},
    "l09.league.ri90": {"fn": "rankIntervals", "args": [{"$input": "l09.league.mc", "path": "pTop"}, {"level": {"$setting": "settings.level90"}}], "note": "90% rank intervals of the league posterior at prior SD .15 (Monte Carlo, 4,000 draws, seed 1)"}
  },
  "keys": {
    "tb19.law3.state.high": {"type": "vector", "from": "l09.law3.high", "field": "means", "format": {"fn": "formatTuple", "item": {"fn": "formatCount"}}, "tolerance": 0, "note": "true values of A, B and C in the state with a large A"},
    "tb19.law3.state.low": {"type": "vector", "from": "l09.law3.low", "field": "means", "format": {"fn": "formatTuple", "item": {"fn": "formatCount"}}, "tolerance": 0, "note": "true values of A, B and C in the state with a small A"},
    "tb19.law3.state.high.A": {"type": "scalar", "from": "l09.law3.high", "field": "means.0", "format": {"fn": "formatCount"}, "tolerance": 0, "note": "A's true value in the state with a large A"},
    "tb19.law3.prob.high": {"type": "scalar", "from": "l09.law3.probs", "field": "means.0", "format": {"fn": "formatProb", "options": {"digits": 1}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}, "note": "probability of the state with a large A"},
    "tb19.law3.prob.low": {"type": "scalar", "from": "l09.law3.probs", "field": "means.1", "format": {"fn": "formatProb", "options": {"digits": 1}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}, "note": "probability of the state with a small A"},
    "tb19.law3.mean.A": {"type": "scalar", "from": "l09.law3", "field": "means.0", "format": {"fn": "formatDecimal", "options": {"digits": 0}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}},
    "tb19.law3.mean.B": {"type": "scalar", "from": "l09.law3", "field": "means.1", "format": {"fn": "formatDecimal", "options": {"digits": 0}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}},
    "tb19.law3.mean.C": {"type": "scalar", "from": "l09.law3", "field": "means.2", "format": {"fn": "formatDecimal", "options": {"digits": 0}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}},
    "tb19.law3.exprank.A": {"type": "scalar", "from": "l09.law3", "field": "expectedRank.0", "format": {"fn": "formatDecimal", "options": {"digits": 1}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}},
    "tb19.law3.exprank.B": {"type": "scalar", "from": "l09.law3", "field": "expectedRank.1", "format": {"fn": "formatDecimal", "options": {"digits": 1}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}},
    "tb19.law3.exprank.C": {"type": "scalar", "from": "l09.law3", "field": "expectedRank.2", "format": {"fn": "formatDecimal", "options": {"digits": 1}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}},
    "tb19.law3.top1.A": {"type": "scalar", "from": "l09.law3", "field": "pTop.0.0", "format": {"fn": "formatProb", "options": {"digits": 1}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}, "note": "probability that A is first"},
    "tb19.law3.top1.B": {"type": "scalar", "from": "l09.law3", "field": "pTop.0.1", "format": {"fn": "formatProb", "options": {"digits": 1}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}},
    "tb19.law3.top1.C": {"type": "scalar", "from": "l09.law3", "field": "pTop.0.2", "format": {"fn": "formatProb", "options": {"digits": 1}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}},
    "tb19.law3.top2.A": {"type": "scalar", "from": "l09.law3", "field": "pTop.1.0", "format": {"fn": "formatProb", "options": {"digits": 1}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}, "note": "probability that A is in the top two"},
    "tb19.law3.top2.B": {"type": "scalar", "from": "l09.law3", "field": "pTop.1.1", "format": {"fn": "formatProb", "options": {"digits": 1}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}},
    "tb19.law3.top2.C": {"type": "scalar", "from": "l09.law3", "field": "pTop.1.2", "format": {"fn": "formatProb", "options": {"digits": 1}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}},
    "tb19.law3.rank3.A": {"type": "scalar", "from": "l09.law3", "field": "rankProbs.2.0", "format": {"fn": "formatProb", "options": {"digits": 1}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}, "note": "probability that A is last (third)"},
    "tb19.law3.rank2.A": {"type": "scalar", "from": "l09.law3", "field": "rankProbs.1.0", "format": {"fn": "formatProb", "options": {"digits": 1}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}, "note": "probability that A is second (zero)"},
    "tb19.law3.pi.BA": {"type": "scalar", "from": "l09.law3.pair", "field": "pi.0.1.0", "format": {"fn": "formatProb", "options": {"digits": 1}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}, "note": "Pr(theta_B > theta_A | Y)"},
    "tb19.law3.pi.CA": {"type": "scalar", "from": "l09.law3.pair", "field": "pi.0.2.0", "format": {"fn": "formatProb", "options": {"digits": 1}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}, "note": "Pr(theta_C > theta_A | Y)"},
    "tb19.law3.pi.BC": {"type": "scalar", "from": "l09.law3.pair", "field": "pi.0.1.2", "format": {"fn": "formatProb", "options": {"digits": 1}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}, "note": "Pr(theta_B > theta_C | Y)"},
    "tb19.law3.M": {"type": "scalar", "fn": "pairCount", "args": [3], "format": {"fn": "formatCount"}, "tolerance": 0, "note": "pairs of three units"},
    "tb19.law3.misordered": {"type": "scalar", "fn": "misorderedPairs", "args": [{"$input": "l09.law3", "path": "means"}, {"$input": "l09.law3.errank", "path": "expectedRank"}], "field": "count", "format": {"fn": "formatCount"}, "tolerance": 0, "note": "pairs that the posterior-mean order and the expected-rank order put in different orders"},

    "tb10.law051.prob.ABC": {"type": "scalar", "from": "l09.law051.probs", "field": "means.0", "format": {"fn": "formatProb", "options": {"digits": 2}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}},
    "tb10.law051.prob.BCA": {"type": "scalar", "from": "l09.law051.probs", "field": "means.1", "format": {"fn": "formatProb", "options": {"digits": 2}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}},
    "tb10.law051.prob.CBA": {"type": "scalar", "from": "l09.law051.probs", "field": "means.2", "format": {"fn": "formatProb", "options": {"digits": 2}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}},
    "tb10.law051.pi.AB": {"type": "scalar", "from": "l09.law051.pair", "field": "pi.0.0.1", "format": {"fn": "formatProb", "options": {"digits": 2}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}},
    "tb10.law051.pi.AC": {"type": "scalar", "from": "l09.law051.pair", "field": "pi.0.0.2", "format": {"fn": "formatProb", "options": {"digits": 2}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}},
    "tb10.law051.pi.BC": {"type": "scalar", "from": "l09.law051.pair", "field": "pi.0.1.2", "format": {"fn": "formatProb", "options": {"digits": 2}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}},
    "tb10.law051.exprank.A": {"type": "scalar", "from": "l09.law051", "field": "expectedRank.0", "format": {"fn": "formatDecimal", "options": {"digits": 2}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}},
    "tb10.law051.exprank.B": {"type": "scalar", "from": "l09.law051", "field": "expectedRank.1", "format": {"fn": "formatDecimal", "options": {"digits": 2}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}},
    "tb10.law051.exprank.C": {"type": "scalar", "from": "l09.law051", "field": "expectedRank.2", "format": {"fn": "formatDecimal", "options": {"digits": 2}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}},
    "tb10.law051.wins.A": {"type": "scalar", "from": "l09.law051.wins.A", "field": "count", "format": {"fn": "formatCount"}, "tolerance": 0, "note": "pairs A wins with probability above one half"},
    "tb10.law051.wins.B": {"type": "scalar", "from": "l09.law051.wins.B", "field": "count", "format": {"fn": "formatCount"}, "tolerance": 0},
    "tb10.law051.wins.C": {"type": "scalar", "from": "l09.law051.wins.C", "field": "count", "format": {"fn": "formatCount"}, "tolerance": 0},

    "league.default.prior15.exprank.U26": {"type": "scalar", "from": "l09.league.er", "field": "25", "format": {"fn": "formatDecimal", "options": {"digits": 2}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}},
    "league.default.prior15.exprank.U21": {"type": "scalar", "from": "l09.league.er", "field": "20", "format": {"fn": "formatDecimal", "options": {"digits": 2}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}},
    "league.default.prior15.exprank.U13": {"type": "scalar", "from": "l09.league.er", "field": "12", "format": {"fn": "formatDecimal", "options": {"digits": 2}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}},
    "league.default.prior15.exprank.U10": {"type": "scalar", "from": "l09.league.er", "field": "9", "format": {"fn": "formatDecimal", "options": {"digits": 2}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}},
    "league.default.prior15.exprank.U06": {"type": "scalar", "from": "l09.league.er", "field": "5", "format": {"fn": "formatDecimal", "options": {"digits": 2}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}},
    "league.default.prior15.exprank.U24": {"type": "scalar", "from": "l09.league.er", "field": "23", "format": {"fn": "formatDecimal", "options": {"digits": 2}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}},
    "league.default.prior15.mean.U13": {"type": "scalar", "from": "l09.league.post", "field": "mean.12", "format": {"fn": "formatDecimal", "options": {"digits": 3}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}},
    "league.default.prior15.mean.U06": {"type": "scalar", "from": "l09.league.post", "field": "mean.5", "format": {"fn": "formatDecimal", "options": {"digits": 3}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}},
    "league.default.prior15.sd.U13": {"type": "scalar", "from": "l09.league.post", "field": "sd.12", "format": {"fn": "formatDecimal", "options": {"digits": 3}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}},
    "league.default.prior15.sd.U06": {"type": "scalar", "from": "l09.league.post", "field": "sd.5", "format": {"fn": "formatDecimal", "options": {"digits": 3}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}},
    "league.default.prior15.sd.U24": {"type": "scalar", "from": "l09.league.post", "field": "sd.23", "format": {"fn": "formatDecimal", "options": {"digits": 3}}, "tolerance": {"abs": 1e-12, "rel": 1e-12}, "note": "U24's posterior SD (the L-09 What to try answer: U06 and U24 pass U13 by expected rank)"},
    "league.default.prior15.misordered.mean.exprank": {"type": "scalar", "fn": "misorderedPairs", "args": [{"$input": "l09.league.post", "path": "mean"}, {"$input": "l09.league.errank", "path": "expectedRank"}], "field": "count", "format": {"fn": "formatCount"}, "tolerance": 0, "note": "league pairs that the posterior-mean order and the exact expected-rank order put in different orders"},
    "league.default.prior05.misordered.mean.exprank": {"type": "scalar", "fn": "misorderedPairs", "args": [{"$input": "l09.league.post05", "path": "mean"}, {"$input": "l09.league.errank05", "path": "expectedRank"}], "field": "count", "format": {"fn": "formatCount"}, "tolerance": 0, "note": "the same count at prior SD .05"},
    "league.default.prior15.mc4000.s1.draws": {"type": "scalar", "from": "l09.league.mc", "field": "S", "format": {"fn": "formatCount"}, "tolerance": 0, "note": "the number of Monte Carlo draws, as the caption writes it (4,000)"},
    "league.default.prior15.mc4000.s1.top1.U26": {"type": "scalar", "from": "l09.league.mc", "field": "pTop.0.25", "format": {"fn": "formatProb", "options": {"digits": 2}}, "tolerance": 0, "note": "Monte Carlo share of the 4,000 draws (seed 1) in which U26 is first"},
    "league.default.prior15.mc4000.s1.top1.U21": {"type": "scalar", "from": "l09.league.mc", "field": "pTop.0.20", "format": {"fn": "formatProb", "options": {"digits": 2}}, "tolerance": 0},
    "league.default.prior15.mc4000.s1.top1.U13": {"type": "scalar", "from": "l09.league.mc", "field": "pTop.0.12", "format": {"fn": "formatProb", "options": {"digits": 2}}, "tolerance": 0},
    "league.default.prior15.mc4000.s1.top1.U08": {"type": "scalar", "from": "l09.league.mc", "field": "pTop.0.7", "format": {"fn": "formatProb", "options": {"digits": 2}}, "tolerance": 0},
    "league.default.prior15.mc4000.s1.top10.U21": {"type": "scalar", "from": "l09.league.mc", "field": "pTop.9.20", "format": {"fn": "formatProb", "options": {"digits": 2}}, "tolerance": 0, "note": "Monte Carlo share of the draws in which U21 is among the top ten"},
    "league.default.prior15.mc4000.s1.top10.U26": {"type": "scalar", "from": "l09.league.mc", "field": "pTop.9.25", "format": {"fn": "formatProb", "options": {"digits": 2}}, "tolerance": 0},
