    "tb19.law3.ri90.lower": {"type": "vector", "from": "l09.law3.ri90", "field": "lower", "format": {"fn": "formatTuple", "item": {"fn": "formatCount"}}, "tolerance": 0, "note": "best end of each unit's 90% rank interval: the first rank whose cumulative probability reaches .05"},
    "tb19.law3.ri90.upper": {"type": "vector", "from": "l09.law3.ri90", "field": "upper", "format": {"fn": "formatTuple", "item": {"fn": "formatCount"}}, "tolerance": 0, "note": "worst end: the first rank whose cumulative probability reaches .95"},
    "league.default.prior15.mc4000.s1.ri90.lower": {"type": "vector", "from": "l09.league.ri90", "field": "lower", "format": {"fn": "formatTuple", "item": {"fn": "formatCount"}}, "tolerance": 0, "note": "best ends of the thirty 90% rank intervals (unit order U01-U30)"},
    "league.default.prior15.mc4000.s1.ri90.upper": {"type": "vector", "from": "l09.league.ri90", "field": "upper", "format": {"fn": "formatTuple", "item": {"fn": "formatCount"}}, "tolerance": 0, "note": "worst ends (unit order U01-U30)"}
