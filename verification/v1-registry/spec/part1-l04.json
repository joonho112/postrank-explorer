{
  "$schema": "../schema.json",
  "spec": "part1-l04",
  "description": "Part 1, What a posterior adds (L-04): the teaching normal-normal posterior of the simulated league (SR-06; prior mean 0) at prior SD .15 and .05 and with every SE set to .10 (the estimates stay those of the frozen draw, seed 20261030). Shares kept, the fraction of the way to the prior mean (normalPosterior with estimate 0 and prior mean 1 gives 1 - share), posterior SDs, pairs whose order changes, and pairs ordered against the true order (this draw and the closed form with the true values fixed).",
  "license_scope": "author",
  "inputs": {
    "l04.league": {"fn":"league30","args":[]},
    "l04.post15": {"fn":"normalPosterior","args":[{"$data":"league-30","path":"tables.units.estimate"},{"$data":"league-30","path":"tables.units.se"},{"priorSd":{"$setting":"settings.prior15"}}],"note":"the frozen draw, prior SD .15"},
    "l04.post05": {"fn":"normalPosterior","args":[{"$data":"league-30","path":"tables.units.estimate"},{"$data":"league-30","path":"tables.units.se"},{"priorSd":{"$setting":"settings.prior05"}}],"note":"the frozen draw, prior SD .05"},
    "l04.post15eq": {"fn":"normalPosterior","args":[{"$data":"league-30","path":"tables.units.estimate"},{"$setting":"settings.se10"},{"priorSd":{"$setting":"settings.prior15"}}],"note":"the frozen estimates with every SE set to .10, prior SD .15"},
    "l04.moved15": {"fn":"normalPosterior","args":[0,{"$input":"l04.league","path":"se"},{"priorMean":1,"priorSd":{"$setting":"settings.prior15"}}],"note":"estimate 0 and prior mean 1: the posterior mean 1 + share (0 - 1) is 1 - share, the fraction of the way to the prior mean"},
    "l04.moved05": {"fn":"normalPosterior","args":[0,{"$input":"l04.league","path":"se"},{"priorMean":1,"priorSd":{"$setting":"settings.prior05"}}],"note":"as l04.moved15 at prior SD .05"},
    "l04.moved15eq": {"fn":"normalPosterior","args":[0,{"$setting":"settings.se10"},{"priorMean":1,"priorSd":{"$setting":"settings.prior15"}}],"note":"as l04.moved15 with SE .10"}
  },
  "keys": {
    "league.spec.n": {"type":"scalar","from":"l04.league","field":"ids.length","format":{"fn":"formatCount"},"tolerance":0,"note":"units in the simulated league"},
    "league.spec.size.small": {"type":"scalar","from":"l04.league","field":"size.0","format":{"fn":"formatCount"},"tolerance":0,"note":"observations per small unit (U01)"},
    "league.spec.size.medium": {"type":"scalar","from":"l04.league","field":"size.1","format":{"fn":"formatCount"},"tolerance":0,"note":"observations per medium unit (U02)"},
    "league.spec.size.large": {"type":"scalar","from":"l04.league","field":"size.2","format":{"fn":"formatCount"},"tolerance":0,"note":"observations per large unit (U03)"},
    "league.spec.se.small": {"type":"scalar","from":"l04.league","field":"se.0","format":{"fn":"formatDecimal","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"SE of a small unit, .8 / sqrt(16)"},
    "league.spec.se.medium": {"type":"scalar","from":"l04.league","field":"se.1","format":{"fn":"formatDecimal","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"SE of a medium unit, .8 / sqrt(64)"},
    "league.spec.se.large": {"type":"scalar","from":"l04.league","field":"se.2","format":{"fn":"formatDecimal","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"SE of a large unit, .8 / sqrt(256)"},
    "league.prior15.moved.small": {"type":"scalar","from":"l04.moved15","field":"mean.0","format":{"fn":"formatDecimal","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"1 - share: the fraction of the way to the prior mean a small unit moves"},
    "league.prior15.moved.medium": {"type":"scalar","from":"l04.moved15","field":"mean.1","format":{"fn":"formatDecimal","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "league.prior15.moved.large": {"type":"scalar","from":"l04.moved15","field":"mean.2","format":{"fn":"formatDecimal","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "league.prior15.postsd.small": {"type":"scalar","from":"l04.post15","field":"sd.0","format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"posterior SD of a small unit, sqrt(share) x SE (it does not depend on the estimate)"},
    "league.prior15.postsd.medium": {"type":"scalar","from":"l04.post15","field":"sd.1","format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "league.prior15.postsd.large": {"type":"scalar","from":"l04.post15","field":"sd.2","format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "league.prior05.shrink.small": {"type":"scalar","from":"l04.post05","field":"shrink.0","format":{"fn":"formatDecimal","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"share kept at prior SD .05 (U01, small)"},
    "league.prior05.shrink.medium": {"type":"scalar","from":"l04.post05","field":"shrink.1","format":{"fn":"formatDecimal","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "league.prior05.shrink.large": {"type":"scalar","from":"l04.post05","field":"shrink.2","format":{"fn":"formatDecimal","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "league.prior05.moved.small": {"type":"scalar","from":"l04.moved05","field":"mean.0","format":{"fn":"formatDecimal","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "league.prior05.moved.medium": {"type":"scalar","from":"l04.moved05","field":"mean.1","format":{"fn":"formatDecimal","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "league.prior05.moved.large": {"type":"scalar","from":"l04.moved05","field":"mean.2","format":{"fn":"formatDecimal","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "league.se10.prior15.shrink": {"type":"scalar","from":"l04.post15eq","field":"shrink.0","format":{"fn":"formatDecimal","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"the one share every unit keeps when every SE is .10"},
    "league.se10.prior15.moved": {"type":"scalar","from":"l04.moved15eq","field":"mean","format":{"fn":"formatDecimal","options":{"digits":2}},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "league.se10.prior15.postsd": {"type":"scalar","from":"l04.post15eq","field":"sd.0","format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "league.default.prior05.reordered": {"type":"scalar","fn":"misorderedPairs","args":[{"$data":"league-30","path":"tables.units.estimate"},{"$input":"l04.post05","path":"mean"}],"field":"count","format":{"fn":"formatCount"},"tolerance":0,"note":"pairs whose order changes from the estimates to the posterior means, prior SD .05"},
    "league.default.se10.prior15.reordered": {"type":"scalar","fn":"misorderedPairs","args":[{"$data":"league-30","path":"tables.units.estimate"},{"$input":"l04.post15eq","path":"mean"}],"field":"count","format":{"fn":"formatCount"},"tolerance":0,"note":"with one share for every unit the order cannot change"},
    "league.default.prior15.pm.misordered": {"type":"scalar","fn":"misorderedPairs","args":[{"$input":"l04.post15","path":"mean"},{"$input":"l04.league","path":"theta"}],"field":"count","format":{"fn":"formatCount"},"tolerance":0,"note":"pairs the posterior-mean order puts against the true order in the frozen draw"},
    "league.default.prior05.pm.misordered": {"type":"scalar","fn":"misorderedPairs","args":[{"$input":"l04.post05","path":"mean"},{"$input":"l04.league","path":"theta"}],"field":"count","format":{"fn":"formatCount"},"tolerance":0},
    "league.default.se10.prior15.pm.misordered": {"type":"scalar","fn":"misorderedPairs","args":[{"$input":"l04.post15eq","path":"mean"},{"$input":"l04.league","path":"theta"}],"field":"count","format":{"fn":"formatCount"},"tolerance":0,"note":"the same order as the estimates, so the same count"},
    "league.closed.prior05.misordered": {"type":"scalar","fn":"expectedMisorderedPairs","args":[{"$input":"l04.league","path":"theta"},{"$input":"l04.league","path":"se"},{"priorSd":{"$setting":"settings.prior05"}}],"format":{"fn":"formatDecimal","options":{"digits":1}},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "league.default.raw.msd": {"type":"scalar","fn":"meanSquaredDistance","args":[{"$data":"league-30","path":"tables.units.estimate"},{"$input":"l04.league","path":"theta"}],"format":{"fn":"formatDecimal","options":{"digits":4}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"average squared distance of the estimates (frozen draw) to the true values, (1/30) sum (estimate - theta)^2"},
    "league.default.prior15.pm.msd": {"type":"scalar","fn":"meanSquaredDistance","args":[{"$input":"l04.post15","path":"mean"},{"$input":"l04.league","path":"theta"}],"format":{"fn":"formatDecimal","options":{"digits":4}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"the same for the posterior means at prior SD .15"},
    "league.default.prior05.pm.msd": {"type":"scalar","fn":"meanSquaredDistance","args":[{"$input":"l04.post05","path":"mean"},{"$input":"l04.league","path":"theta"}],"format":{"fn":"formatDecimal","options":{"digits":4}},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "league.default.raw.sd": {"type":"scalar","fn":"summaryStats","args":[{"$data":"league-30","path":"tables.units.estimate"}],"field":"sd","format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"spread of the estimates across the 30 units: sample SD with divisor n - 1"},
    "league.default.prior15.pm.sd": {"type":"scalar","fn":"summaryStats","args":[{"$input":"l04.post15","path":"mean"}],"field":"sd","format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "league.default.prior05.pm.sd": {"type":"scalar","fn":"summaryStats","args":[{"$input":"l04.post05","path":"mean"}],"field":"sd","format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "league.spec.theta.sd": {"type":"scalar","fn":"summaryStats","args":[{"$input":"l04.league","path":"theta"}],"field":"sd","format":{"fn":"formatDecimal","options":{"digits":3}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"spread of the true values (no randomness)"},
    "league.default.prior15.farther": {"type":"scalar","fn":"fartherCount","args":[{"$data":"league-30","path":"tables.units.estimate"},{"$input":"l04.post15","path":"mean"},{"$input":"l04.league","path":"theta"}],"field":"count","format":{"fn":"formatCount"},"tolerance":0,"note":"units whose posterior mean ends farther from the true value than the estimate was: |pm - theta| > |estimate - theta|"},
    "league.default.prior05.farther": {"type":"scalar","fn":"fartherCount","args":[{"$data":"league-30","path":"tables.units.estimate"},{"$input":"l04.post05","path":"mean"},{"$input":"l04.league","path":"theta"}],"field":"count","format":{"fn":"formatCount"},"tolerance":0}
  }
}
