{
  "$schema": "../schema.json",
  "spec": "part2-g04",
  "description": "Part 2, Why a report must be coherent (G-04): KRW's Example 1 (three firms, independent normal posteriors N(omega_i, 1) with omega = (2, omega_2, 0)) at the two KRW presets omega_2 = .80 and .50 and at the question's omega_2 = 1, and the theory book's three-unit finite law (ch. 10: orders ABC 3/5, ACB 3/20, BAC 3/20, CBA 1/10) at tau = .20. The KRW values at omega_2 = 1 (pi, optimum, relaxed value, band) and the law's optimum, relaxed value and report 1/1/2 are krwex1.* and tb10.law3.* in part2.json; this fragment adds the rest of what the G-04 page writes.",
  "license_scope": "author",
  "inputs": {
    "g04.krw.omega80.E": {"fn":"errorArray","args":[[2,{"$setting":"settings.g04.omega80"},0],[1,1,1],{}],"note":"KRW Example 1 at omega_2 = .80 (the deck preset)"},
    "g04.krw.omega80.tau20": {"fn":"exactOptimum","args":[{"$input":"g04.krw.omega80.E"},{"tau":{"$setting":"settings.tau20"},"family":{"kind":"all"}}]},
    "g04.krw.omega50.E": {"fn":"errorArray","args":[[2,{"$setting":"settings.g04.omega50"},0],[1,1,1],{}],"note":"KRW Example 1 at omega_2 = .50"},
    "g04.krw.omega50.tau20": {"fn":"exactOptimum","args":[{"$input":"g04.krw.omega50.E"},{"tau":{"$setting":"settings.tau20"},"family":{"kind":"all"}}]},
    "g04.krw.omega1.E": {"fn":"errorArray","args":[[2,1,0],[1,1,1],{}],"note":"KRW Example 1 at omega_2 = 1 (the question's setting; the same input as krwex1.omega2_1.E)"},
    "g04.krw.omega1.tau20": {"fn":"exactOptimum","args":[{"$input":"g04.krw.omega1.E"},{"tau":{"$setting":"settings.tau20"},"family":{"kind":"all"}}],"note":"the question's setting (the same optimum as krwex1.omega2_1.tau20)"},
    "g04.law3": {"fn":"finiteLawPairwise","args":[[[[3],[2],[1]],[[3],[1],[2]],[[2],[3],[1]],[[1],[2],[3]]],[0.6,0.15,0.15,0.1],{"ids":["A","B","C"]}],"note":"theory book ch. 10: orders ABC 3/5, ACB 3/20, BAC 3/20, CBA 1/10 (the same input as tb10.law3)"},
    "g04.law3.probs": {"fn":"rankSummaries","args":[{"states":[[0.6,0.15,0.15,0.1]],"probs":null}],"note":"the four order probabilities gathered as a one-state law (means = the values)"}
  },
  "keys": {
    "g04.krw.omega80.pi12": {"type":"scalar","fn":"pairDirection","args":[2,1,{"$setting":"settings.g04.omega80"},1],"format":{"fn":"formatProb"},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "g04.krw.omega80.pi23": {"type":"scalar","fn":"pairDirection","args":[{"$setting":"settings.g04.omega80"},1,0,1],"format":{"fn":"formatProb"},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "g04.krw.omega80.tau20.grade": {"type":"vector","from":"g04.krw.omega80.tau20","field":"grade","format":{"fn":"formatGrades"},"tolerance":0},
