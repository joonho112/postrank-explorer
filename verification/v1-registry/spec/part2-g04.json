    "g04.krw.omega80.tau20.optrisk": {"type":"scalar","from":"g04.krw.omega80.tau20","field":"risk","format":{"fn":"formatRisk"},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "g04.krw.omega80.tau20.relaxed": {"type":"scalar","fn":"relaxedPairRisk","args":[{"$input":"g04.krw.omega80.E"},{"tau":{"$setting":"settings.tau20"}}],"format":{"fn":"formatRisk"},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"independent pair choices; here they print as the optimum"},
    "g04.krw.omega81.pi12": {"type":"scalar","fn":"pairDirection","args":[2,1,{"$setting":"settings.g04.omega81"},1],"format":{"fn":"formatProb","options":{"digits":5}},"tolerance":{"abs":1e-12,"rel":1e-12},"note":"just below .80, so five digits (the widget shows as many digits as it needs to tell it from 1 - tau)"},
    "g04.krw.omega50.pi12": {"type":"scalar","fn":"pairDirection","args":[2,1,{"$setting":"settings.g04.omega50"},1],"format":{"fn":"formatProb"},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "g04.krw.omega50.pi23": {"type":"scalar","fn":"pairDirection","args":[{"$setting":"settings.g04.omega50"},1,0,1],"format":{"fn":"formatProb"},"tolerance":{"abs":1e-12,"rel":1e-12}},
    "g04.krw.omega50.tau20.grade": {"type":"vector","from":"g04.krw.omega50.tau20","field":"grade","format":{"fn":"formatGrades"},"tolerance":0},
